<?xml version="1.0" encoding="utf-8"?>
<!--
    Una squadra in campo, nel menu partita: la barra del suo colore, la sigla e chi la compone. Non e'
    un comando, quindi niente pressione e niente card: e' una riga del gruppo "In campo", letta da
    TalkBack come una frase sola (la descrizione la scrive MenuActivity).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_12"
    android:paddingVertical="@dimen/space_8"
    android:screenReaderFocusable="true">

    <View
        android:id="@+id/squadra_barra"
        android:layout_width="@dimen/team_bar_width"
        android:layout_height="@dimen/team_bar_height"
        android:layout_marginEnd="@dimen/space_8"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <TextView
            android:id="@+id/squadra_nome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.Lista.Titolo"
            android:textAlignment="viewStart" />

        <TextView
            android:id="@+id/squadra_giocatori"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Lista.Dettaglio"
            android:textAlignment="viewStart" />
    </LinearLayout>

</LinearLayout>
