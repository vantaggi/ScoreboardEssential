<?xml version="1.0" encoding="utf-8"?>
<!--
    La prossima partita della serata, dal polso. Un compito: decidere chi gioca e cominciare. In cima
    il numero della partita, poi le due coppie (due gruppi tonali con la sigla sopra, una riga per
    giocatore: si tocca un nome e poi un altro per scambiarli), chi resta fuori, e i due bottoni:
    Ruota, tonale, e Inizia, l'unico primario. La riga di avviso dice che cosa sta succedendo
    (scegli, aspetto il telefono, non ha risposto) e TalkBack la legge quando cambia. Su nero come il
    menu e come lui a tutta larghezza: il titolo scorre via con la colonna, e sul tondo ogni blocco
    si stringe vicino al bordo (BordoTondo). La corona scorre la colonna.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prossima_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/prossima_colonna"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/lista_margine_lati"
        android:paddingTop="@dimen/lista_margine_alto"
        android:paddingBottom="@dimen/lista_margine_basso">

        <TextView
            android:id="@+id/prossima_titolo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.Lista.Titolo" />

        <TextView
            android:id="@+id/prossima_avviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Lista.Dettaglio" />

        <TextView
            android:id="@+id/prossima_sigla1"
            style="@style/Widget.App.Sigla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/prossima_coppia1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_group"
            android:clipToOutline="true"
            android:divider="@drawable/bg_group_divider"
            android:orientation="vertical"
            android:showDividers="middle" />

        <TextView
            android:id="@+id/prossima_sigla2"
            style="@style/Widget.App.Sigla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12" />

        <LinearLayout
            android:id="@+id/prossima_coppia2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_group"
            android:clipToOutline="true"
            android:divider="@drawable/bg_group_divider"
            android:orientation="vertical"
            android:showDividers="middle" />

        <TextView
            android:id="@+id/prossima_panchina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Lista.Dettaglio"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prossima_ruota"
            style="@style/Widget.App.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/wear_next_rotate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prossima_inizia"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/wear_next_start" />
    </LinearLayout>
</ScrollView>
