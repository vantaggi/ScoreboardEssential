<?xml version="1.0" encoding="utf-8"?>
<!--
    La scelta dello sport (e della regola del 40-40 e del portiere), con le righe del menu: a tutta
    larghezza, il titolo che scorre via con la lista, ogni riga sul suo tono e stretta solo vicino al
    bordo del tondo (BordoTondo). Le scelte sono poche e fisse: una colonna basta. Il focus serve
    alla corona (requestFocus in onCreate).
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sport_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/lista_margine_lati"
        android:paddingTop="@dimen/lista_margine_alto"
        android:paddingBottom="@dimen/lista_margine_basso">

        <!-- Il titolo e' una riga a 14sp: lascia lo spazio alle voci, che sono la cosa da leggere. -->
        <TextView
            android:id="@+id/sport_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:accessibilityHeading="true"
            android:text="@string/wear_sport_title"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.Lista.Titolo"
            android:maxLines="1"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/sport_voci"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/bg_spazio_righe"
            android:orientation="vertical"
            android:showDividers="middle" />

    </LinearLayout>
</ScrollView>
