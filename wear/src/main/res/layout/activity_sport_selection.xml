<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asphalt_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_boxedEdges="all">

        <!-- Il titolo e' una riga a 14sp: lascia lo spazio alle voci, che sono la cosa da leggere. -->
        <TextView
            android:id="@+id/sport_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wear_sport_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textSize="14sp"
            android:maxLines="1"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Focusable perche' la corona scorre la vista che ha il focus (requestFocus in onCreate). -->
        <androidx.wear.widget.WearableRecyclerView
            android:id="@+id/sport_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </LinearLayout>

</androidx.wear.widget.BoxInsetLayout>
