<?xml version="1.0" encoding="utf-8"?>
<!--
    La scelta del marcatore. Sta su nero perche' e' una schermata di gioco: si apre dal bersaglio
    CHI? mentre la partita continua, e il nero e' lo sfondo di tutto cio' che si usa a partita in
    corso. Niente BoxInsetLayout: la lista va a tutta larghezza con i margini delle altre liste del
    polso, e sul tondo le righe si stringono vicino al bordo come nel menu (ScalaTonda). In cima
    l'intestazione dice QUALE gol e la barra e' nel colore della squadra che ha segnato: e' la prima
    riga della lista e scorre via con lei (08-wearable), non sta ferma sopra.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_watch"
    android:orientation="vertical">

    <!--
        Il focus serve alla corona: senza, ruotarla non scorre niente. I margini alto e basso sono
        quelli del menu: l'ultima riga arriva al centro dello schermo.
    -->
    <androidx.wear.widget.WearableRecyclerView
        android:id="@+id/player_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingHorizontal="@dimen/lista_margine_lati"
        android:paddingTop="@dimen/lista_margine_alto"
        android:paddingBottom="@dimen/lista_margine_basso"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/empty_state_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/wear_no_players"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone" />

</LinearLayout>
