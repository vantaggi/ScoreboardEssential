<?xml version="1.0" encoding="utf-8"?>
<!--
    Una riga della scelta del marcatore: la barra del colore della squadra e il nome, niente card
    e niente ruolo (il marcatore si riconosce dal nome). Alta almeno 52dp, il minimo per un tocco
    sicuro con il polso in movimento. La stessa riga serve a SALTA, con la barra spenta.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/lista_riga_minima"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_12"
    android:paddingEnd="@dimen/space_12"
    android:stateListAnimator="?attr/pressFeedback">

    <View
        android:id="@+id/player_bar"
        android:layout_width="@dimen/team_bar_width"
        android:layout_height="@dimen/team_bar_height"
        android:layout_marginEnd="@dimen/space_8"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/player_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/text_on_watch"
        android:textAppearance="@style/TextAppearance.Lista.Nome"
        android:textAlignment="viewStart" />

</LinearLayout>
