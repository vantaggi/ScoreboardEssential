<?xml version="1.0" encoding="utf-8"?>
<!--
    Una riga della scelta del marcatore: la barra del colore della squadra e il nome, niente card
    e niente ruolo (il marcatore si riconosce dal nome). Alta almeno 52dp, il minimo per un tocco
    sicuro con il polso in movimento. La stessa riga serve a SALTA, con la barra spenta.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/scorer_row_inset"
    android:paddingEnd="@dimen/scorer_row_inset"
    android:stateListAnimator="?attr/pressFeedback">

    <View
        android:id="@+id/player_bar"
        android:layout_width="4dp"
        android:layout_height="24dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/player_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/inter"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ink_white"
        android:textSize="18sp"
        android:textFontWeight="600"
        android:textAlignment="viewStart" />

</LinearLayout>
