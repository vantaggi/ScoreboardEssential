<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_black"
    tools:context=".MainActivity"
    tools:deviceIds="wear">

    <!-- Layer 1: Keeper Progress Ring (Bottom) -->
    <ProgressBar
        android:id="@+id/keeperProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:indeterminate="false"
        android:max="300"
        android:progress="300"
        android:progressDrawable="@drawable/circular_progress_bar" />

    <!-- Layer 2: UI Content (Top) -->
    <androidx.wear.widget.BoxInsetLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            app:layout_boxedEdges="all">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.20" />

        <!-- Connection Status Indicator -->
        <View
            android:id="@+id/connectionStatusIndicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/shape_circle"
            android:backgroundTint="@color/error_red"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp" />

        <!-- Match Timer - Top Center -->
        <TextView
            android:id="@+id/matchTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="@dimen/wear_timer_text_size"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:textColor="@color/stencil_white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>

        <!-- Team 1 Score - Left Side -->
        <LinearLayout
            android:id="@+id/team1Container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/guideline_top"
            app:layout_constraintBottom_toTopOf="@id/gestureHint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/keeperTimer">

            <TextView
                android:id="@+id/team1Score"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="100sp"
                android:autoSizeStepGranularity="2sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/team_spray_yellow"/>

            <TextView
                android:id="@+id/team1ScoreDetail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/wear_score_detail_height"
                android:gravity="center"
                android:maxLines="1"
                android:visibility="gone"
                android:includeFontPadding="false"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/sidewalk_gray"
                tools:text="6-4 3-6 2-1"
                tools:visibility="visible"/>
        </LinearLayout>

        <!-- Team 2 Score - Right Side -->
        <LinearLayout
            android:id="@+id/team2Container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/guideline_top"
            app:layout_constraintBottom_toTopOf="@id/gestureHint"
            app:layout_constraintStart_toEndOf="@id/keeperTimer"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/team2Score"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="100sp"
                android:autoSizeStepGranularity="2sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/team_electric_green"/>

            <TextView
                android:id="@+id/team2ScoreDetail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/wear_score_detail_height"
                android:gravity="center"
                android:maxLines="1"
                android:visibility="gone"
                android:includeFontPadding="false"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/sidewalk_gray"
                tools:text="6-4 3-6 2-1"
                tools:visibility="visible"/>
        </LinearLayout>

        <!-- Keeper Timer Interaction Target - Center -->
        <TextView
            android:id="@+id/keeperTimer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="K"
            android:textSize="@dimen/wear_keeper_timer_text_size"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:textColor="@color/graffiti_pink"
            android:contentDescription="@string/cd_keeper_timer"
            app:layout_constraintTop_toBottomOf="@id/matchTimer"
            app:layout_constraintBottom_toTopOf="@id/gestureHint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Che cosa fa tenere premuto. Cambia con lo sport, e senza di essa non lo dice nessuno. -->
        <TextView
            android:id="@+id/gestureHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wear_hint_minus"
            android:textSize="@dimen/wear_hint_text_size"
            android:fontFamily="sans-serif-condensed"
            android:textColor="@color/sidewalk_gray"
            android:letterSpacing="0.06"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@id/btn_start_new_match"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!--
            In basso due comandi: lo sport e la fine della partita. Sono l'unica coppia della
            schermata, quindi una catena "packed" invece di misure fisse: le etichette sono corte
            e restano entro il quadrato inscritto anche sui quadranti tondi.
        -->
        <Button
            android:id="@+id/btn_sport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wear_sport"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:textColor="@color/sidewalk_gray"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:textSize="@dimen/wear_button_text_size"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="8dp"
            android:visibility="gone"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_start_new_match"
            android:layout_marginBottom="12dp"
            tools:visibility="visible" />

        <!-- Reset Button - Bottom Center -->
        <Button
            android:id="@+id/btn_start_new_match"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wear_reset"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:textColor="@color/sidewalk_gray"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:textSize="@dimen/wear_button_text_size"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_sport"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="12dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.wear.widget.BoxInsetLayout>
</FrameLayout>
