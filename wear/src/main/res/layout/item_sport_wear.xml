<?xml version="1.0" encoding="utf-8"?>
<!--
    Una riga delle liste del polso (menu, impostazioni, scelta dello sport), come i bottoni di Wear:
    l icona a sinistra, il nome e sotto la riga del perche' o del valore, allineati all inizio. Alta
    almeno 52dp, sul suo tono (surface) e a tutta larghezza: si stringe solo vicino al bordo del tondo.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.App.GroupRow"
    app:cardPreventCornerOverlap="@bool/voce_rientro_angolo"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingHorizontal="@dimen/space_12"
        android:paddingVertical="@dimen/voce_padding_verticale">

        <!-- Decorativa: il nome accanto dice gia' tutto. Il colore e' quello del nome (MenuActivity). -->
        <ImageView
            android:id="@+id/voce_icona"
            android:layout_width="@dimen/icon_standard"
            android:layout_height="@dimen/icon_standard"
            android:layout_marginEnd="@dimen/space_8"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Il nome a 15sp in 600, in frase. TitoloIntero e' un TextView che, se la parola piu'
                 lunga non entra, scende di dimensione fino a 14sp invece di spezzarla: a tutta
                 larghezza succede di rado, ma la regola resta. -->
            <it.vantaggi.scoreboardessential.wear.TitoloIntero
                android:id="@+id/sport_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:textFontWeight="600"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textAlignment="viewStart" />

            <!-- La riga secondaria: "in uso" nella scelta dello sport, il perche' o il valore nel menu. -->
            <TextView
                android:id="@+id/sport_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wear_sport_current"
                android:fontFamily="@font/inter"
                android:textSize="12sp"
                android:letterSpacing="0"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAlignment="viewStart"
                android:visibility="gone"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
