<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/concrete_gray"
    app:shapeAppearance="@style/ShapeAppearance.App.StreetCard"
    app:cardElevation="0dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:layout_margin="2dp">

        <!-- Titolo a 20sp bold: e' testo grande WCAG, serve a FINE PARTITA rosso su #1E1E1E. -->
        <TextView
            android:id="@+id/sport_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textSize="20sp"
            android:textColor="@color/stencil_white"
            android:gravity="center" />

        <!-- La riga secondaria: "in uso" nella scelta dello sport, il perche' o il risultato nel menu. -->
        <TextView
            android:id="@+id/sport_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wear_sport_current"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="2dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
