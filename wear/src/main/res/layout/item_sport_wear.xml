<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.App.GroupRow"
    app:cardPreventCornerOverlap="@bool/voce_rientro_angolo"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="@dimen/voce_padding_verticale"
        android:layout_margin="2dp">

        <!-- Titolo a 20sp semibold (600), in frase e non in maiuscolo. L'errore su elite_surface fa 4,7:1.
             TitoloIntero e' un TextView che, se la parola piu' lunga non entra nella card (sul tondo
             da 192dp le card sono strette), scende di dimensione fino a 14sp invece di spezzarla.
             Scelto al posto di un rientro piu' stretto del BoxInsetLayout: quel rientro tiene le card
             dentro il cerchio. Il rientro interno della card e' sceso da 12dp a 8dp, che da' 8dp in
             piu' al testo (sul tondo da 192dp "CHIUDERE" a 14sp ne vuole 66, e ne aveva 64). Lo stesso layout
             serve il menu e la selezione dello sport. -->
        <it.vantaggi.scoreboardessential.wear.TitoloIntero
            android:id="@+id/sport_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textSize="20sp"
            android:textColor="@color/elite_text_primary"
            android:gravity="center" />

        <!-- La riga secondaria: "in uso" nella scelta dello sport, il perche' o il risultato nel menu. -->
        <TextView
            android:id="@+id/sport_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wear_sport_current"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textSize="12sp"
            android:letterSpacing="0"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="2dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
