<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/menu_box_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_boxedEdges="all">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wear_menu_title"
            android:textColor="@color/elite_text_primary"
            android:fontFamily="@font/inter"
            android:textFontWeight="600"
            android:textSize="14sp"
            android:maxLines="1"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!--
            Le voci sono due e fisse: una ScrollView basta, e la corona la scorre quando il
            tondo da 192dp non le contiene tutte e due. Il focus serve alla corona. Le voci sono
            le righe di UN gruppo tonale (surface, raggio 14, senza ombra) con la linea sottile fra
            l'una e l'altra.
        -->
        <ScrollView
            android:id="@+id/menu_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/menu_voci"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_group"
                android:clipToOutline="true"
                android:divider="@drawable/bg_group_divider"
                android:orientation="vertical"
                android:showDividers="middle" />
        </ScrollView>

    </LinearLayout>

</androidx.wear.widget.BoxInsetLayout>
