<resources>
    <string name="app_name">Scoreboard Essential</string>

    <!-- Il gesto lungo cambia significato con lo sport: nel calcio toglie un punto a quella
         squadra, negli sport a set annulla l'ultima azione qualunque lato l'abbia segnata. -->
    <string name="wear_hint_minus">TIENI: −1</string>
    <string name="wear_hint_undo">TIENI: ANNULLA</string>
    <!-- Nome della squadra e punteggio a schermo: TalkBack legge questa frase al posto delle cifre. -->
    <string name="cd_score_side_minus">%1$s, %2$s. Tocca per segnare, tieni premuto per togliere un punto.</string>
    <string name="cd_score_side_undo">%1$s, %2$s. Tocca per segnare, tieni premuto per annullare l ultima azione.</string>
    <string name="cd_team_fallback">Squadra %1$d</string>
    <!-- Chi serve: uno o due pallini accanto alle cifre, per il primo o il secondo giocatore. -->
    <string name="cd_serving">%1$s al servizio</string>
    <string name="cd_serving_first_player">%1$s al servizio, primo giocatore</string>
    <string name="cd_serving_second_player">%1$s al servizio, secondo giocatore</string>
    <!-- Cronometro del calcio e game del set in corso: il bersaglio in alto a sinistra. -->
    <string name="cd_match_clock_running">Cronometro %1$s, in corso. Tocca per fermare.</string>
    <string name="cd_match_clock_stopped">Cronometro %1$s, fermo. Tocca per avviare.</string>
    <string name="cd_current_game">Set in corso, game %1$s</string>

    <!-- Menu partita: frasi corte, perche' il tondo da 192dp lascia circa 100dp di larghezza alla voce. -->
    <string name="cd_menu">Menu partita</string>
    <string name="wear_menu_title">PARTITA</string>
    <string name="wear_menu_end">FINE PARTITA</string>
    <string name="wear_menu_end_saves">Salva %1$s sul telefono</string>
    <string name="wear_menu_end_confirm">CHIUDERE %1$s?</string>
    <string name="wear_menu_tap_again">Tocca di nuovo</string>
    <string name="wear_menu_phone_needed">Serve il telefono</string>
    <string name="wear_menu_football_on_phone">Chiudi dal telefono</string>
    <string name="wear_menu_nothing_to_save">Niente da salvare</string>
    <plurals name="wear_menu_deliver_first">
        <item quantity="one">Prima consegna %1$d punto</item>
        <item quantity="other">Prima consegna %1$d punti</item>
    </plurals>
    <string name="wear_who_scored">CHI HA SEGNATO?</string>
    <string name="wear_no_players">Nessun giocatore</string>
    <string name="wear_who_short">CHI?</string>
    <string name="wear_skip">SALTA</string>
    <string name="wear_goal_header">GOL · %1$s</string>
    <string name="wear_goal_header_plain">GOL</string>
    <string name="cd_keeper_timer">Conto alla rovescia del portiere</string>
    <string name="wear_sport">SPORT</string>
    <string name="wear_sport_title">SPORT</string>
    <!-- Il segno davanti si legge anche senza il colore: in uso e' ciano, ma la spunta dice la stessa cosa. -->
    <string name="wear_sport_current">✓ in uso</string>
    <string name="wear_sport_locked">Partita in corso</string>
    <string name="wear_match_over">PARTITA FINITA</string>
    <!-- Riga di stato: una frase sola, al massimo 18 caratteri anche con un numero a tre cifre.
         Nel tondo da 192dp il testo piu' lungo si taglia, quindi niente frasi nuove senza misurarle. -->
    <string name="wear_status_rejected">%1$d RIFIUTATI</string>
    <string name="wear_status_not_confirmed">NON CONFERMATO</string>
    <string name="wear_status_delivered">%1$d CONSEGNATI</string>
    <string name="wear_status_closing">CHIUSURA…</string>
    <string name="wear_status_close_unconfirmed">NON CONFERMATA</string>
    <string name="wear_status_changing_sport">CAMBIO SPORT…</string>
    <string name="wear_status_sport_unchanged">SPORT NON CAMBIATO</string>
    <string name="wear_status_not_delivered">%1$d NON CONSEGNATI</string>
    <string name="wear_status_sending">INVIO %1$d…</string>
    <string name="wear_status_queued">%1$d IN CODA</string>
    <string name="wear_status_offline">SCOLLEGATO</string>
    <string name="wear_status_offline_at">SCOLLEGATO · %1$s</string>
    <string name="wear_scorer_not_sent">MARCATORE NON INVIATO</string>
</resources>
