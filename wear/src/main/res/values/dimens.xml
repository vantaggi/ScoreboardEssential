<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
    Il quadrante di gioco non usa piu' BoxInsetLayout: le fasce stanno in percentuale
    dell'altezza (guide nel layout) e ogni fascia ha il suo margine di corda, cioe' quanto serve
    per stare dentro il cerchio all'altezza del suo bordo alto. Misure in dp a 192, dal design:
    B (cifre) 12, D (dettaglio) 16, E (stato) 30. Nei quadrati (values-notround) i margini sono 0.
    -->
    <dimen name="box_inset_layout_padding">0dp</dimen>

    <!-- radius-control (le righe) e radius-surface (il gruppo), gli stessi del telefono. -->
    <dimen name="radius_control">8dp</dimen>
    <dimen name="radius_surface">14dp</dimen>
    <!-- La linea sottile fra le righe di un gruppo. -->
    <dimen name="border_width">1dp</dimen>
    <!-- La corsa di una cifra che rotola: un quarto dell'altezza della sua scatola, la meta' del
         telefono (50%): sull'orologio il movimento e' piu' breve (wearable.md). -->
    <fraction name="number_roll_travel">25%</fraction>

    <!-- icon-compact, icon-standard, icon-prominent: le tre misure delle icone, le stesse del telefono. -->
    <dimen name="icon_compact">16dp</dimen>
    <dimen name="icon_standard">20dp</dimen>
    <dimen name="icon_prominent">24dp</dimen>
    <!-- Il vuoto fra un'icona e il testo che la segue. -->
    <dimen name="icon_text_gap">4dp</dimen>

    <dimen name="face_margin_d">16dp</dimen>
    <dimen name="face_margin_e">30dp</dimen>

    <!-- Il vuoto fra il testo della fascia A e il centro, dal lato del cronometro. -->
    <dimen name="face_context_gap">5dp</dimen>

    <!-- Il pallino del servizio: una fascia riservata sul lato esterno di ogni colonna, sempre,
         cosi' il numero non si sposta quando il pallino compare. Il primo pallino sta sul lato
         esterno a distanza di corda, il secondo (batte il secondo giocatore) accanto, verso le
         cifre, ma piu' in alto del loro bordo. -->
    <dimen name="face_dot_size">8dp</dimen>
    <dimen name="face_dot_inset">14dp</dimen>
    <!-- Il vuoto fra i due pallini, quando batte il secondo giocatore. -->
    <dimen name="face_dot_gap">3dp</dimen>
    <!-- Dal bordo alto del lato: i pallini stanno sopra l'altezza delle cifre, cosi' il secondo
         non finisce mai sul testo. -->
    <dimen name="face_dot_top">2dp</dimen>
    <!-- Dove finiscono le cifre dal lato del centro: il resto del vuoto fra le due colonne. -->
    <dimen name="face_digits_gutter">4dp</dimen>
    <!-- Margine delle cifre dal lato esterno: corda piu' fascia del pallino. -->
    <dimen name="face_digits_outer">24dp</dimen>

    <!-- La striscia di squadra e il suo scarto dal bordo, centrata sotto la colonna delle cifre. -->
    <dimen name="face_stripe_width">28dp</dimen>
    <dimen name="face_stripe_height">4dp</dimen>
    <dimen name="face_stripe_inset">44dp</dimen>

    <!-- Il bersaglio inferiore: il menu, e per 8s dopo un gol CHI?. -->
    <dimen name="face_menu_inset">24dp</dimen>

    <!-- La scelta del marcatore: quanto sta sotto il bordo alto del tondo l'intestazione, e quanto
         rientrano le righe dai lati. Nei quadrati servono meno. -->
    <dimen name="scorer_top_inset">22dp</dimen>
    <dimen name="scorer_row_inset">22dp</dimen>

    <!-- Testi: le cifre sono a dimensione FISSA, niente autoSize, cosi' "AV" e "40" hanno la stessa
         misura da un lato all'altro e fra uno stato e l'altro. In dp e non in sp: stanno in colonne
         fisse da 68dp con una riga sola e senza puntini, e col carattere di sistema grande (fino a
         1,24 sull'orologio) 58sp diventano 72: "AV" andava a capo e "40" restava "4", cioe' un
         punteggio sbagliato. Non e' un testo da leggere ingrandito: e' gia' la cosa piu' grande
         dello schermo, e a ingrandirsi sono gli altri livelli. -->
    <dimen name="face_score_text_size">58dp</dimen>
    <dimen name="face_context_text_size">20sp</dimen>
    <dimen name="face_keeper_text_size">14sp</dimen>
    <dimen name="face_detail_text_size">13sp</dimen>

    <!-- La riga di stato: dimensione massima e altezza fissa; sotto, l'autoSize arriva a 10sp. -->
    <dimen name="wear_hint_text_size">12sp</dimen>
    <dimen name="wear_hint_height">16dp</dimen>

    <!--
    Il menu e la selezione dello sport sul tondo da 192dp (values: e' la misura piccola, i quadrati e
    il 227dp la ripristinano in values-notround e values-sw210dp).

    L'area visibile del menu e' circa 77dp: sotto il BoxInsetLayout e il titolo PARTITA restano il
    rientro di 28dp per lato, piu' il padding. Una voce spenta con la sua riga del perche' (titolo
    su due righe e sottotitolo su due) ne chiede piu' di 100, e il perche' restava sotto la piega.
    Tre rimedi piccoli, uno per ogni spreco: il padding del BoxInsetLayout a 4dp (le card restano
    dentro il cerchio: l'angolo basso dista 90,5dp dal centro su 96), il rientro verticale interno
    della voce a 4dp, e niente rientro d'angolo della card (il taglio e' di 12dp, ne mangiava 6 per
    lato fra testo e bordo: il testo parte a 6dp dal bordo, il taglio a quell'altezza e' a 6dp).
    -->
    <dimen name="menu_box_padding">4dp</dimen>
    <dimen name="voce_padding_verticale">4dp</dimen>
    <bool name="voce_rientro_angolo">false</bool>
</resources>
