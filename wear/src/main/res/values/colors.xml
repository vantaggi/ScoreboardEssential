<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nero puro, fondo di gioco: sugli schermi OLED sono pixel spenti e il bianco arriva a
         21:1. Stesso nome del telefono (DESIGN.md, token condivisi), per non farli divergere. -->
    <color name="ink_black">#000000</color>
    <!-- Bianco puro: le cifre del punteggio, il cronometro che corre e il pallino del servizio
         (21:1 su nero). Stesso nome del telefono. -->
    <color name="ink_white">#FFFFFF</color>
    <color name="asphalt_dark">#121212</color>
    <color name="concrete_gray">#1E1E1E</color>
    <color name="stencil_white">#E0E0E0</color>
    <color name="sidewalk_gray">#9E9E9E</color>
    <color name="graffiti_pink">#F50057</color>
    <color name="neon_cyan">#00E5FF</color>
    <color name="team_spray_yellow">#FFD600</color>
    <color name="team_electric_green">#76FF03</color>
    <color name="error_red">#FF1744</color>
    <!-- Testo distruttivo su fondi grigi (6.12:1 su #1E1E1E): error_red e' testo solo su nero.
         Stesso nome e valore del telefono; quando i token passeranno in :shared va tolto da qui. -->
    <color name="error_text">#FF6E6E</color>
    <!-- Stati di consegna: il punto e' salvo, ma il telefono non ce l'ha. 11.7:1 su nero. Solo al
         polso, perche' la coda di consegna esiste solo li'. -->
    <color name="signal_amber">#FFB300</color>

    <!-- Previous semantic aliases for wear theme, now mapped to the new palette -->
    <color name="background">@color/asphalt_dark</color>
    <color name="surface">@color/concrete_gray</color>
</resources>
