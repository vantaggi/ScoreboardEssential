<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        TOKEN DEL QUADRANTE (DESIGN.md, Adattamento alla UI Constitution, G-7). Stessi nomi e stessi
        valori del telefono (mobile/src/main/res/values/colors.xml): un test li confronta, cosi' le due
        palette non possono divergere. Qui ci sono solo i ruoli che l'orologio usa; i nove colori Street
        che il quadrante teneva da solo (asphalt_dark, concrete_gray, stencil_white, sidewalk_gray,
        graffiti_pink, neon_cyan, team_spray_yellow, team_electric_green, error_red) sono tolti.
    -->
    <!-- background-watch: il nero puro del quadrante e di ogni schermata dell'orologio. Sugli schermi
         OLED sono pixel spenti e il bianco arriva a 21:1. -->
    <color name="background_watch">#000000</color>
    <!-- Le cifre del punteggio e del cronometro che corre (21:1 su nero). -->
    <color name="text_on_watch">#FFFFFF</color>

    <!-- background-surface: il gruppo tonale del menu e della scelta dello sport. -->
    <color name="background_surface">#161618</color>
    <!-- state-selected: la riga scelta per uno scambio nella prossima partita, con il nome in lime e a 600. -->
    <color name="background_elevated">#1E1E22</color>
    <!-- border-subtle: la linea sottile fra le righe di un gruppo. -->
    <color name="border_subtle">#2A2A2E</color>
    <!-- text-primary e text-secondary (contrasti sul nero 13,8 e 6,2; sul gruppo 11,9 e 5,3). -->
    <color name="text_primary">#D1D1D8</color>
    <color name="text_secondary">#8A8A9A</color>
    <!-- text-disabled: solo le etichette di una voce spenta, sotto 4,5 per scelta della Constitution;
         il perche' sta nel sottotitolo, che e' text-secondary. -->
    <color name="text_disabled">#6B7077</color>
    <!-- accent-default: il lime, sul quadrante solo per chi serve (identita' dell'orologio). -->
    <color name="accent_default">#C8F135</color>
    <color name="on_accent">#0D0D0F</color>
    <!-- Ciano: sull'orologio solo come predefinito del lato 2, come sul telefono. -->
    <color name="chart_2">#00E5FF</color>
    <!-- status-warning (ambra: coda non consegnata) e status-error (rosso: errore e distruttivo). -->
    <color name="status_warning">#E09A35</color>
    <color name="status_error">#E05252</color>

    <!-- Colori predefiniti delle squadre, gli stessi del telefono (G-6): lime e ciano. Il telefono
         manda i suoi quando la partita ha colori scelti dall'utente, e quelli vincono. -->
    <color name="team_side_1">@color/accent_default</color>
    <color name="team_side_2">@color/chart_2</color>

    <!-- Il solo grigio che parla in ambient (la riga di stato, il cronometro fermo): 11,2:1 su nero,
         senza tinta, perche' in ambient non c'e' colore. -->
    <color name="text_ambient">#BDBDBD</color>

    <!-- background-canvas: lo cita solo il fondo dell'icona (G-9), come sul telefono. L'orologio ha un
         tema solo, quello standard, quindi qui il nome e' senza suffisso. -->
    <color name="background_canvas">#0D0D0F</color>
</resources>
