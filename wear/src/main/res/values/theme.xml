<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Il tema dell'orologio sui ruoli della UI Constitution (DESIGN.md, G-7), con i valori di Padel
        Elite gia' usati dal telefono. Un solo tema, scuro. Il fondo e' il nero del quadrante
        (background-watch) anche per il menu e per la scelta dello sport: niente secondo fondo grigio.
        Il lime e' l'unico accento e sul quadrante marca solo chi serve: nel tema c'e' per i ruoli di
        Material, non perche' un componente lo usi.
    -->
    <style name="Theme.ScoreboardEssential" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/elite_lime</item>
        <item name="colorOnPrimary">@color/elite_on_lime</item>
        <!-- Il secondario e' neutro, come sul telefono. -->
        <item name="colorSecondary">@color/elite_text_secondary</item>
        <item name="colorOnSecondary">@color/ink_black</item>
        <item name="colorError">@color/elite_error</item>
        <item name="colorOnError">@color/ink_black</item>
        <item name="android:colorBackground">@color/ink_black</item>
        <item name="colorOnBackground">@color/elite_text_primary</item>
        <item name="colorSurface">@color/elite_surface</item>
        <item name="colorOnSurface">@color/elite_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/elite_text_secondary</item>
        <item name="colorOutlineVariant">@color/elite_border_strong</item>
        <!-- Niente tinta di elevazione: le superfici si alzano di tono coi token, mai di tinta. -->
        <item name="elevationOverlayEnabled">false</item>

        <!--
            Caratteri (DESIGN.md, G-1): Inter per il testo, in tre pesi (400, 600 qui; 500 resta
            disponibile). Le cifre del quadrante restano sul condensato (vedi Face.Score). Niente
            android:fontFamily nel tema: la vista lo legge DOPO il suo textAppearance e lo
            sovrascriverebbe, cifre comprese. Nessun maiuscolo forzato.
        -->
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.HeadlineSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge</item>

        <!-- Forme: tutte arrotondate, sui raggi della Constitution (8 per i comandi, 14 per i gruppi). -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Control</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Surface</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.Surface</item>

        <!-- La pressione di ogni controllo (animator/press_feedback.xml); il movimento ridotto la sostituisce. -->
        <item name="pressFeedback">@animator/press_feedback</item>
    </style>

    <!--
        Movimento ridotto (ANIMATOR_DURATION_SCALE = 0): la pressione perde la scala e tiene la sola
        opacita'. Lo applica MovimentoRidotto.kt a ogni activity prima che gonfi i layout.
    -->
    <style name="ThemeOverlay.App.MovimentoRidotto" parent="">
        <item name="pressFeedback">@animator/press_feedback_reduced</item>
    </style>

    <style name="TextAppearance.App.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/elite_text_primary</item>
    </style>
    <style name="TextAppearance.App.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/elite_text_primary</item>
    </style>
    <style name="TextAppearance.App.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/elite_text_secondary</item>
    </style>

    <!--
        Il tema del quadrante di gioco: la finestra e' gia' nera, quindi il layout non dipinge un
        secondo fondo (lint Overdraw). Le schermate di contorno restano sul tema di sopra.

        Niente chiusura con lo swipe verso destra: a meta' partita chiuderebbe il quadrante e con lui
        il ViewModel, e si perderebbe cio' che il polso non ha ancora consegnato. Si esce col tasto.
        Vale solo qui: le altre schermate tengono lo swipe come indietro.
    -->
    <style name="Theme.ScoreboardEssential.Face" parent="Theme.ScoreboardEssential">
        <item name="android:windowBackground">@color/ink_black</item>
        <item name="android:windowSwipeToDismiss">false</item>
    </style>

    <!--
        I cinque livelli di lettura del quadrante. Le cifre (Score, Context, Keeper) restano condensed
        bold: Inter non entra nella colonna (CifreDelQuadranteTest). Detail, Who e Status sono Inter,
        senza il margine di font: il testo sta in fasce alte quanto serve e non un pixel di piu'.
        Le misure vengono da dimens, quindi crescono da sole sui tondi da 227dp.
    -->
    <style name="TextAppearance.Face.Score" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/face_score_text_size</item>
        <item name="android:textColor">@color/ink_white</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Face.Context" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/face_context_text_size</item>
        <item name="android:textColor">@color/ink_white</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Face.Keeper" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/face_keeper_text_size</item>
        <item name="android:textColor">@color/elite_text_secondary</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Face.Detail" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/face_detail_text_size</item>
        <item name="android:textColor">@color/elite_text_secondary</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.Face.Who" parent="android:TextAppearance">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_white</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <style name="TextAppearance.Face.Status" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/wear_hint_text_size</item>
        <item name="android:textColor">@color/elite_text_secondary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Forme della UI Constitution: radius-control 8dp, radius-surface 14dp. Tutte rounded. -->
    <style name="ShapeAppearance.App.Control" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_control</item>
    </style>
    <style name="ShapeAppearance.App.Surface" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_surface</item>
    </style>

    <!--
        Una riga di un gruppo tonale (menu e scelta dello sport): sullo stesso tono del gruppo, senza
        ombra e senza bordo, con la pressione condivisa. La linea fra le righe la mette il gruppo.
    -->
    <style name="Widget.App.GroupRow" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/elite_surface</item>
        <item name="cardElevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Control</item>
        <item name="android:stateListAnimator">?attr/pressFeedback</item>
    </style>
</resources>
