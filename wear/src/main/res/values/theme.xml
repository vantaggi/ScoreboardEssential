<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ScoreboardEssential" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Street Vibe Color Palette -->
        <item name="colorPrimary">@color/graffiti_pink</item>
        <item name="colorOnPrimary">@color/stencil_white</item>
        <item name="colorSecondary">@color/neon_cyan</item>
        <item name="colorOnSecondary">@color/asphalt_dark</item>
        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/stencil_white</item>
        <item name="android:colorBackground">@color/asphalt_dark</item>
        <item name="colorSurface">@color/concrete_gray</item>
        <item name="colorOnSurface">@color/stencil_white</item>
        <item name="colorOnSurfaceVariant">@color/sidewalk_gray</item>

        <!-- Street Vibe Typeface References -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.DisplayLarge.Street</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.HeadlineMedium.Street</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.HeadlineSmall.Street</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge.Street</item>

        <!-- Street Vibe Shape References for Wear OS -->
        <!-- Wear OS uses different component styles, so we apply shapes directly or through widgets -->
    </style>

    <!-- Street Vibe Type and Shape -->
    <style name="TextAppearance.App.DisplayLarge.Street" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="TextAppearance.App.HeadlineMedium.Street" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextAppearance.App.HeadlineSmall.Street" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.App.BodyLarge.Street" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!--
        Il tema del quadrante di gioco: la finestra e' gia' nera, quindi il layout non dipinge un
        secondo fondo (lint Overdraw). Le schermate di contorno restano sul tema street.

        Niente chiusura con lo swipe verso destra: a meta' partita chiuderebbe il quadrante e con lui
        il ViewModel, e si perderebbe cio' che il polso non ha ancora consegnato. Si esce col tasto.
        Vale solo qui: le altre schermate tengono lo swipe come indietro.
    -->
    <style name="Theme.ScoreboardEssential.Face" parent="Theme.ScoreboardEssential">
        <item name="android:windowBackground">@color/ink_black</item>
        <item name="android:windowSwipeToDismiss">false</item>
    </style>

    <!--
        I cinque livelli di lettura del quadrante. Tutti condensed bold salvo il dettaglio, e tutti
        senza il margine di font: il testo sta in fasce alte quanto serve e non un pixel di piu'.
        Le misure vengono da dimens, quindi crescono da sole sui tondi da 227dp.
    -->
    <style name="TextAppearance.Face.Score" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/face_score_text_size</item>
        <item name="android:textColor">@color/ink_white</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Face.Context" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/face_context_text_size</item>
        <item name="android:textColor">@color/ink_white</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Face.Keeper" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/face_keeper_text_size</item>
        <item name="android:textColor">@color/sidewalk_gray</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Face.Detail" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/face_detail_text_size</item>
        <item name="android:textColor">@color/sidewalk_gray</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>
    <style name="TextAppearance.Face.Who" parent="android:TextAppearance">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_white</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <style name="TextAppearance.Face.Status" parent="android:TextAppearance">
        <item name="android:textSize">@dimen/wear_hint_text_size</item>
        <item name="android:textColor">@color/sidewalk_gray</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="ShapeAppearance.App.StreetCard" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Note: ShapeAppearance attributes like shapeAppearanceMediumComponent might not be respected
         in the same way on Wear OS. It's often better to apply shapes directly to widgets
         or create custom widget styles. We will apply shapes in the layouts. -->
</resources>