<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">Scoreboard Essential</string>

    <!-- Il gesto lungo cambia significato con lo sport: nel calcio toglie un punto a quella
         squadra, negli sport a set annulla l'ultima azione qualunque lato l'abbia segnata. -->
    <string name="wear_hint_minus">Hold: −1</string>
    <string name="wear_hint_undo">Hold: undo</string>
    <!-- Nome della squadra e punteggio a schermo: TalkBack legge questa frase al posto delle cifre. -->
    <string name="cd_score_side_minus">%1$s, %2$s. Tap to add a point, press and hold to remove one.</string>
    <string name="cd_score_side_undo">%1$s, %2$s. Tap to add a point, press and hold to undo the last action.</string>
    <string name="cd_team_fallback">Team %1$d</string>
    <!-- Chi serve: uno o due pallini accanto alle cifre, per il primo o il secondo giocatore. -->
    <string name="cd_serving">%1$s serving</string>
    <string name="cd_serving_first_player">%1$s serving, first player</string>
    <string name="cd_serving_second_player">%1$s serving, second player</string>
    <!-- Cronometro del calcio e game del set in corso: il bersaglio in alto a sinistra. -->
    <string name="cd_match_clock_running">Match clock %1$s, running. Tap to stop.</string>
    <string name="cd_match_clock_stopped">Match clock %1$s, stopped. Tap to start.</string>
    <string name="cd_current_game">Current set, games %1$s</string>

    <!-- Menu, scelta dello sport e frasi del quadrante (riga di stato, Chi?, Salta, Gol, Partita
         finita): tutto in frase, mai in maiuscolo (G-7 e G-9). Il maiuscolo non e' piu' un segno. -->
    <!-- Menu partita: frasi corte, perche' il tondo da 192dp lascia circa 100dp di larghezza alla voce. -->
    <string name="cd_menu">Match menu</string>
    <string name="wear_menu_title">Match</string>
    <string name="wear_menu_end">End match</string>
    <string name="wear_menu_end_saves">Saves %1$s on the phone</string>
    <string name="wear_menu_end_confirm">Close %1$s?</string>
    <string name="wear_menu_tap_again">Tap again</string>
    <string name="wear_menu_phone_needed">Phone needed</string>
    <string name="wear_menu_nothing_to_save">Nothing to save</string>
    <plurals name="wear_menu_deliver_first">
        <item quantity="one">Deliver %1$d point first</item>
        <item quantity="other">Deliver %1$d points first</item>
    </plurals>
    <string name="wear_menu_discard">Discard queue</string>
    <string name="wear_menu_discard_confirm">Discard?</string>
    <plurals name="wear_menu_rejected_points">
        <item quantity="one">The phone rejected %1$d point</item>
        <item quantity="other">The phone rejected %1$d points</item>
    </plurals>
    <string name="wear_who_scored">Who scored?</string>
    <string name="wear_no_players">No players</string>
    <!-- Il marcatore: la finestra in basso dice CHI?, la lista si apre con SALTA in cima. Frasi
         brevi, perche' il tondo da 192dp lascia circa 100dp di larghezza. -->
    <string name="wear_who_short">Who?</string>
    <string name="wear_skip">Skip</string>
    <string name="wear_goal_header">Goal · %1$s</string>
    <string name="wear_goal_header_plain">Goal</string>
    <string name="cd_keeper_timer">Goalkeeper countdown</string>
    <!-- Uguale nelle due lingue: K e i minuti:secondi che restano al portiere. -->
    <string name="wear_keeper_running" translatable="false">K %1$d:%2$02d</string>
    <string name="wear_sport">Sport</string>
    <string name="wear_sport_title">Sport</string>
    <!-- Il segno davanti si legge anche senza il colore: in uso e' ciano, ma la spunta dice la stessa cosa. -->
    <string name="wear_sport_current">in use</string>
    <string name="wear_sport_locked">Match in progress</string>
    <string name="wear_match_over">Match over</string>
    <!-- Riga di stato: una frase sola, al massimo 18 caratteri anche con un numero a tre cifre.
         Nel tondo da 192dp il testo piu' lungo si taglia, quindi niente frasi nuove senza misurarle. -->
    <string name="wear_status_rejected" tools:ignore="PluralsCandidate">%1$d rejected</string>
    <string name="wear_status_not_confirmed">Not confirmed</string>
    <string name="wear_status_delivered" tools:ignore="PluralsCandidate">%1$d delivered</string>
    <string name="wear_status_closing">Closing…</string>
    <string name="wear_status_close_unconfirmed">Not confirmed</string>
    <string name="wear_status_changing_sport">Changing sport…</string>
    <string name="wear_status_sport_unchanged">Sport not changed</string>
    <string name="wear_status_phone_waiting">Waiting for phone</string>
    <string name="wear_status_not_delivered" tools:ignore="PluralsCandidate">%1$d not delivered</string>
    <string name="wear_status_sending">Sending %1$d…</string>
    <string name="wear_status_queued" tools:ignore="PluralsCandidate">%1$d queued</string>
    <string name="wear_status_offline">Offline</string>
    <string name="wear_status_offline_at">Offline · %1$s</string>
    <string name="wear_scorer_not_sent">Scorer not sent</string>

    <!-- Next match of the evening and teams on court (match menu). -->
    <string name="wear_next_match">Next match</string>
    <string name="wear_next_match_title">Match %1$d</string>
    <string name="wear_next_match_tiebreak">Decider · match %1$d</string>
    <string name="wear_next_pairs">%1$s – %2$s</string>
    <string name="wear_next_hint">Tap two names to swap them</string>
    <string name="wear_next_pick">Swap %1$s with?</string>
    <string name="wear_next_waiting">Waiting for the phone…</string>
    <string name="wear_next_no_answer">The phone did not answer</string>
    <string name="wear_next_delivered">Already on the board</string>
    <string name="wear_next_bench">Sitting out: %1$s</string>
    <string name="wear_next_rotate">Rotate</string>
    <string name="wear_next_start">Start</string>
    <string name="wear_next_back">Back to score</string>
    <string name="cd_next_player">%1$s, pair %2$d</string>
    <string name="cd_next_player_selected">%1$s, pair %2$d, picked for the swap</string>
    <string name="wear_in_campo">On court</string>
    <string name="cd_squadra">%1$s: %2$s</string>
    <string name="wear_settings">Settings</string>
    <string name="wear_setting_deuce">At deuce</string>
    <string name="wear_setting_vibration">Vibration</string>
    <string name="wear_setting_vibration_on">Every point</string>
    <string name="wear_setting_vibration_off">Alerts only</string>
    <string name="wear_setting_keeper">Keeper</string>
    <string name="wear_keeper_off">Off</string>
    <string name="wear_keeper_seconds">%1$d s</string>
    <string name="wear_keeper_minutes">%1$d min</string>
    <string name="wear_keeper_minutes_seconds">%1$d min %2$d s</string>

    <!-- Icona sul quadrante mentre si gioca (Ongoing Activity): il canale e il testo della notifica. -->
    <string name="wear_ongoing_channel">Match in progress</string>
    <string name="wear_ongoing_status">Match in progress</string>
</resources>
