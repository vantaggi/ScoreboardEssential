<resources>
    <string name="app_name">Scoreboard Essential</string>
    <!--
    This string is used for square devices and overridden by hello_world in
    values-round/strings.xml for round devices.
    -->
    <!-- Il gesto lungo cambia significato con lo sport: nel calcio toglie un punto a quella
         squadra, negli sport a set annulla l'ultima azione qualunque lato l'abbia segnata. -->
    <string name="wear_hint_minus">HOLD: -1</string>
    <string name="wear_hint_undo">HOLD: UNDO</string>
    <string name="cd_score_side_minus">Team %1$d. Tap to add a point, press and hold to remove one.</string>
    <string name="cd_score_side_undo">Team %1$d. Tap to add a point, press and hold to undo the last action.</string>
</resources>