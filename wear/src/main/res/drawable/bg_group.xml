<?xml version="1.0" encoding="utf-8"?>
<!--
    Il gruppo tonale del menu e della scelta dello sport: background-surface a raggio dei gruppi (14dp),
    senza ombra e senza bordo (sul nero un bordo non serve: il tono basta). Le righe dentro sono sullo
    stesso tono, e il gruppo le ritaglia.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/elite_surface" />
    <corners android:radius="@dimen/radius_surface" />
</shape>
