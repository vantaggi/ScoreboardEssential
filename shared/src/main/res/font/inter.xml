<?xml version="1.0" encoding="utf-8"?>
<!--
    Inter (SIL OFL 1.1, docs/licenses/OFL-Inter.txt), versione 4.1, sottoinsieme latino.
    Famiglia con quattro pesi: textStyle bold sceglie il 700, textFontWeight il resto.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/inter_regular" />
    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/inter_medium" />
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/inter_bold" />
    <font
        android:fontStyle="normal"
        android:fontWeight="900"
        android:font="@font/inter_black" />
</font-family>
