<?xml version="1.0" encoding="utf-8"?>
<!--
    JetBrains Mono (SIL OFL 1.1, docs/licenses/OFL-JetBrainsMono.txt), versione 2.304, sottoinsieme
    latino. Due pesi, per i punteggi: 700 (textStyle bold) e 800 (textFontWeight 800). Le cifre sono
    gia' tutte larghe uguale (0,6 em): il tnum non cambia nulla qui, ma lo stile lo chiede lo stesso.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/jetbrains_mono_bold" />
    <font
        android:fontStyle="normal"
        android:fontWeight="800"
        android:font="@font/jetbrains_mono_extrabold" />
</font-family>
