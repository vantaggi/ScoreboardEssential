<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Solo per l'invio a Padel Elite, che parte solo quando l'utente lo chiede; senza configurazione la funzione e' spenta. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- La diretta di Padel Elite (D-3): il servizio in primo piano di tipo dataSync, separato dal cronometro. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application android:name=".ScoreboardEssentialApplication" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:enableOnBackInvokedCallback="true" android:fullBackupContent="@xml/backup_rules" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:label="@string/app_name" android:localeConfig="@xml/locales_config" android:supportsRtl="true" android:theme="@style/Theme.ScoreboardEssential" tools:targetApi="31">

        <!-- Wear capabilities defined in res/values/wear.xml -->

        <!--
            La schermata di gioco resta in verticale (DESIGN.md, decisioni del 24 settembre,
            telefono 4): a bordo campo nessuno usa l'orizzontale, e toglie una variante da tenere.
            Blocco voluto, quindi niente avvisi di lint sull'orientamento.
        -->
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait" tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.onboarding.OnboardingActivity" android:exported="false" android:theme="@style/Theme.ScoreboardEssential" />
        <activity android:name=".MatchHistoryActivity" android:exported="false" android:label="@string/title_match_history" android:parentActivityName=".MainActivity">
            <meta-data android:name="android.support.PARENT_ACTIVITY" android:value=".MainActivity" />
        </activity>
        <activity android:name=".ui.chronicle.ChronicleActivity" android:exported="false" android:label="@string/chronicle_title" />
        <!-- Esportata solo per il ritorno dell'accesso con Google (AccessoGoogle.RITORNO); singleTask perche'
             il browser lo consegni all'istanza gia' aperta. Il codice senza il verificatore PKCE non vale niente. -->
        <activity android:name=".padelelite.PadelEliteActivity" android:exported="true" android:launchMode="singleTask" android:label="@string/padel_elite_title" android:parentActivityName=".ui.MatchSettingsActivity">
            <meta-data android:name="android.support.PARENT_ACTIVITY" android:value=".ui.MatchSettingsActivity" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="scoreboardessential" android:host="padel-elite" android:path="/accesso" />
            </intent-filter>
        </activity>
        <activity android:name=".AddEditPlayerActivity" android:exported="false" android:label="@string/title_player" android:parentActivityName=".PlayersManagementActivity">
            <meta-data android:name="android.support.PARENT_ACTIVITY" android:value=".PlayersManagementActivity" />
        </activity>

        <activity android:name=".ui.MatchSettingsActivity" android:exported="false" android:label="@string/title_match_settings" android:parentActivityName=".MainActivity">
            <meta-data android:name="android.support.PARENT_ACTIVITY" android:value=".MainActivity" />
        </activity>
        <activity android:name=".SerataActivity" android:exported="false" android:label="@string/title_serata" android:parentActivityName=".MainActivity">
            <meta-data android:name="android.support.PARENT_ACTIVITY" android:value=".MainActivity" />
        </activity>
        <activity android:name=".PlayersManagementActivity" android:exported="false" android:label="@string/title_manage_players" android:parentActivityName=".MainActivity">
            <meta-data android:name="android.support.PARENT_ACTIVITY" android:value=".MainActivity" />
        </activity>
        <activity android:name=".ui.statistics.StatisticsActivity" android:exported="false" android:label="@string/title_statistics" android:parentActivityName=".MainActivity">
            <meta-data android:name="android.support.PARENT_ACTIVITY" android:value=".MainActivity" />
        </activity>
        <activity android:name=".ui.statistics.SchedaGiocatoreActivity" android:exported="false" android:label="@string/title_player" android:parentActivityName=".ui.statistics.StatisticsActivity">
            <meta-data android:name="android.support.PARENT_ACTIVITY" android:value=".ui.statistics.StatisticsActivity" />
        </activity>
        <!--
            Nessun android:permission su questo servizio. Qui c'era BIND_WEARABLE_LISTENER_SERVICE,
            messo per restringere chi puo' collegarsi: ma Google Play Services quel permesso non
            lo possiede, e sull'orologio lo stesso attributo bloccava ogni consegna ("Permission
            Denial"). Il controllo su chi chiama lo fa gia' WearableListenerService.
        -->
        <service
            android:name=".SimplifiedDataLayerListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/scoreboard" />
            </intent-filter>
        </service>
        <service
            android:name=".service.MatchTimerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.property.FOREGROUND_SERVICE_TYPE_SPECIAL_USE_DESCRIPTION"
                android:resource="@string/fgs_special_use_description" />
        </service>

        <!--
            Tiene vivo il processo, e con lui il motore della partita, mentre si gioca: col telefono in tasca il
            sistema congela un processo senza servizio in primo piano e l'orologio non rivede il punteggio. Parte
            solo con la partita in corso e l'app visibile; non esportato.
        -->
        <service
            android:name=".service.PartitaInCorsoServizio"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.property.FOREGROUND_SERVICE_TYPE_SPECIAL_USE_DESCRIPTION"
                android:resource="@string/partita_in_corso_special_use_description" />
        </service>

        <!--
            La diretta (D-3): parte solo quando l'utente accende l'interruttore, o quando la diretta riprende dopo
            la morte del processo, e si ferma con la diretta. Non esportato: lo avvia solo l'app.
        -->
        <service
            android:name=".padelelite.DirettaService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            Sotto API 33 il sistema non conserva la lingua scelta nell'app: con autoStoreLocales
            la salva AppCompat e la riapplica a ogni avvio. Da API 33 la tiene il sistema, e
            locales_config elenca le lingue che le impostazioni di sistema possono proporre.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.provider" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>