<?xml version="1.0" encoding="utf-8"?>
<!--
    Riga selezionata di un gruppo (state-selected): superficie rialzata. Da sola non basta: la selezione ha
    sempre un secondo segno (la spunta lime e il nome a peso 600), perche' il tono dista poco dal gruppo.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/elite_surface_raised" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
