<?xml version="1.0" encoding="utf-8"?>
<!-- Pomello dell'interruttore: la spunta solo da acceso (secondo segno oltre al lime), niente da spento. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_switch_check" android:state_checked="true" />
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="24dp"
                android:height="24dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
