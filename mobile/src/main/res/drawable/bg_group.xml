<?xml version="1.0" encoding="utf-8"?>
<!--
    Gruppo tonale (UI Constitution): superficie su canvas, bordo di 1dp, raggio radius-surface,
    nessuna ombra. Per i contenitori statici; un elemento indipendente e' una card (Widget.App.Card).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/elite_surface" />
    <stroke
        android:width="@dimen/border_width"
        android:color="@color/elite_border" />
    <corners android:radius="@dimen/radius_surface" />
</shape>
