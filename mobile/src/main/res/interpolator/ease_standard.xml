<?xml version="1.0" encoding="utf-8"?>
<!--
    ease-standard della UI Constitution, cubic-bezier(0.2, 0, 0, 1): la curva di tutto cio' che non
    deve rimbalzare (opacita', colore, la corsa di una cifra). Il numero che rotola la usa insieme a
    duration_standard.
-->
<pathInterpolator xmlns:android="http://schemas.android.com/apk/res/android"
    android:controlX1="0.2"
    android:controlY1="0"
    android:controlX2="0"
    android:controlY2="1" />
