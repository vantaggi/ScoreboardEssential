<?xml version="1.0" encoding="utf-8"?>
<!-- M1: chiudendo torna verso l'angolo del suo bottone, in duration_instant. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/duration_instant"
    android:interpolator="@interpolator/ease_exit"
    android:shareInterpolator="true">
    <scale
        android:fromXScale="1"
        android:fromYScale="1"
        android:pivotX="100%"
        android:pivotY="0%"
        android:toXScale="@dimen/scale_popover"
        android:toYScale="@dimen/scale_popover" />
    <alpha
        android:fromAlpha="1"
        android:toAlpha="0" />
</set>
