<?xml version="1.0" encoding="utf-8"?>
<!-- N2, l'inverso di N1: la schermata di prima torna dal lato iniziale mentre compare. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/duration_standard"
    android:interpolator="@interpolator/ease_enter"
    android:shareInterpolator="true">
    <translate
        android:fromXDelta="@fraction/shift_axis_indietro"
        android:toXDelta="0" />
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />
</set>
