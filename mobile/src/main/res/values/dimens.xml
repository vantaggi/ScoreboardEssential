<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        La colonna di gioco a slot fissi (DESIGN.md, Forme e spaziature). Tutte le altezze sono
        fisse: durante la partita nessuna vista cambia misura, cosi' il + sta sempre dove il dito se
        lo aspetta. Non esiste values-land: la schermata e' bloccata in verticale nel manifest.
    -->
    <dimen name="game_bar_height">56dp</dimen>
    <dimen name="game_names_height">48dp</dimen>
    <dimen name="game_detail_height">48dp</dimen>
    <dimen name="game_strip_height">56dp</dimen>
    <dimen name="game_zone_height">112dp</dimen>
    <!--
        Limiti del numero, in dp e non in sp: la dimensione si calcola una volta in MainActivity
        (Paint.measureText nella meta' di colonna) e va applicata in pixel. In sp, con il carattere
        di sistema al 200% il tetto raddoppierebbe e il numero uscirebbe dal suo spazio.
    -->
    <dimen name="score_text_max">150dp</dimen>
    <dimen name="score_text_min">72dp</dimen>
    <!--
        Ruoli della UI Constitution (DESIGN.md, Mappatura dei ruoli): spaziature, raggi, bersaglio.
        Un valore nuovo entra qui solo se nomina un ruolo riusabile.
    -->
    <!-- space-4 .. space-64 -->
    <dimen name="space_4">4dp</dimen>
    <dimen name="space_8">8dp</dimen>
    <dimen name="space_12">12dp</dimen>
    <dimen name="space_16">16dp</dimen>
    <dimen name="space_24">24dp</dimen>
    <dimen name="space_32">32dp</dimen>
    <dimen name="space_48">48dp</dimen>
    <dimen name="space_64">64dp</dimen>
    <!-- radius-control: bottoni, campi, voci. radius-surface: gruppi, card, foglio. -->
    <dimen name="radius_control">8dp</dimen>
    <dimen name="radius_surface">14dp</dimen>
    <!-- radius-overlay: dialoghi e menu (uguale a radius-surface, conflitto dichiarato 8). -->
    <dimen name="radius_overlay">14dp</dimen>
    <!-- Raggio dei badge: Padel Elite li disegna solo col bordo, senza sfondo. -->
    <dimen name="radius_badge">6dp</dimen>
    <!-- control-touch: altezza e larghezza minime di ogni comando. -->
    <dimen name="control_touch">48dp</dimen>
</resources>
