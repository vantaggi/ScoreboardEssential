<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Valori del tema chiaro (DESIGN.md, "Tema chiaro"). Stessi ruoli di colors.xml. Il fondo, i gruppi, il bordo e i
        testi sono i valori chiari della Constitution che il report PDF usa gia' (print_*): una sola carta chiara
        nell'app, ora anche sullo schermo. Il lime non c'e': su bianco fa 1,3:1, e l'accento diventa un oliva scuro
        (6,1:1 sul fondo). ThemeOverlay.App.Chiaro li assegna agli attributi; li controlla ChiaroTest.
    -->
    <color name="elite_background_chiaro">#FFFFFF</color>
    <color name="elite_surface_chiaro">#F4F5F7</color>
    <!-- background-elevated: dialoghi e campi; sul gruppo grigio stacca per tono, sul fondo per il bordo. -->
    <color name="elite_surface_raised_chiaro">#FFFFFF</color>
    <color name="elite_surface_hover_chiaro">#E8EAEE</color>
    <color name="elite_border_chiaro">#E3E5EA</color>
    <color name="elite_border_strong_chiaro">#D0D3D9</color>
    <!-- Contorno dei comandi: 3:1 su fondo, gruppo e rialzata. -->
    <color name="elite_outline_chiaro">#767A83</color>
    <color name="elite_text_primary_chiaro">#1A1C1F</color>
    <color name="elite_text_secondary_chiaro">#5A5F66</color>
    <color name="elite_text_disabled_chiaro">#8D9199</color>
    <!-- Il testo sopra l'accento: bianco sull'oliva. -->
    <color name="elite_on_lime_chiaro">#FFFFFF</color>
    <color name="elite_accent_chiaro">#4F6B00</color>
    <color name="elite_focus_ring_chiaro">#4F6B00</color>
    <color name="elite_warning_chiaro">#8A5A00</color>
    <color name="elite_error_chiaro">#B3261E</color>
    <color name="elite_info_chiaro">#1D5F8F</color>
    <color name="elite_success_subtle_chiaro">#EAF2D0</color>
    <color name="elite_warning_subtle_chiaro">#FBEFD5</color>
    <color name="elite_error_subtle_chiaro">#FBE4E2</color>
    <color name="elite_info_subtle_chiaro">#E1EEF8</color>
    <color name="elite_state_pressed_chiaro">#1F1A1C1F</color>
    <!-- Il campo di gioco chiaro: fondo bianco e cifre quasi nere. -->
    <color name="elite_game_background_chiaro">#FFFFFF</color>
    <color name="elite_game_ink_chiaro">#111113</color>
</resources>
