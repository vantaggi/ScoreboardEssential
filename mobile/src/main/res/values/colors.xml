<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        TOKEN DI PADEL ELITE (DESIGN.md, pista "Coerenza con Padel Elite"). Valori veri da css/style.css
        della dashboard, tema Navy scuro. E' la fonte unica del contorno: il tema M3 (themes.xml) e,
        passo dopo passo, i layout si appoggiano a questi nomi e non a un esadecimale. Il quadrante
        dell'orologio ha il suo colors.xml e qui non si tocca (G-7).
    -->
    <!-- Fondi: pagina, card, superficie rialzata (dialoghi, campi), hover. -->
    <color name="background_canvas_standard">#0D0D0F</color>
    <color name="background_surface_standard">#161618</color>
    <color name="background_elevated_standard">#1E1E22</color>
    <color name="state_hover_standard">#2A2A2E</color>
    <!--
        Bordi della dashboard: servono a separare le card, non a farsi trovare. Contro i fondi
        valgono 1,1:1 e 1,4:1, quindi NON bastano come contorno di un comando o di un campo
        (WCAG 1.4.11 chiede 3:1): per quello c'e' border_strong.
    -->
    <color name="border_group_standard">#1E1E22</color>
    <color name="border_subtle_standard">#2A2A2E</color>
    <!--
        Contorno di campi e pulsanti secondari, una scelta dell'app e non della dashboard: la tinta
        del testo secondario scurita fino a 3,3:1 sulla superficie rialzata (3,6 sulla superficie,
        3,9 sul fondo). E' il ruolo colorOutline del tema.
    -->
    <color name="border_strong_standard">#6E6E7E</color>
    <!-- Testi: primario e secondario. La Constitution non ha un terzo livello leggibile (tolto in G-4). -->
    <color name="text_primary_standard">#D1D1D8</color>
    <color name="text_secondary_standard">#8A8A9A</color>
    <!-- Marchio: l'unico accento del contorno. Il testo sopra il lime e' il fondo, mai il bianco (1,3:1). -->
    <color name="accent_default_standard">#C8F135</color>
    <color name="on_accent_standard">#0D0D0F</color>
    <!-- Il campo di gioco: nel tema scuro nero puro e cifre bianche (DESIGN.md, Colori); i valori stanno piu' sotto. -->
    <!-- Anello di fuoco: lime nel tema standard, bianco in quello ad alto contrasto (G-10). -->
    <color name="focus_ring_standard">@color/accent_default_standard</color>
    <!-- Successo = lime, come nella dashboard. -->
    <color name="status_success">@color/accent_default_standard</color>
    <!-- Ciano: SOLO visualizzazioni e grafici (Cronaca, momentum), mai nel contorno dei comandi. -->
    <color name="chart_2">#00E5FF</color>
    <color name="status_warning_standard">#E09A35</color>
    <!-- Errore: testo e icone su fondo e superficie (4,7:1 sulla superficie, 4,3:1 sulla rialzata). -->
    <color name="status_error_standard">#E05252</color>
    <!-- Velo dei dialoghi: nero all'85%. -->
    <color name="scrim">#D9000000</color>

    <!--
        Ruoli della UI Constitution aggiunti da G-2 (DESIGN.md, Mappatura dei ruoli). Il commento di
        ogni token dice il ruolo; l'origine (P, C, A) e i contrasti sono nella tabella del documento.
    -->
    <!-- text-disabled: solo etichette di comandi disattivati, sotto 4,5 per scelta della Constitution. -->
    <color name="text_disabled_standard">#6B7077</color>
    <!-- status-info: avviso informativo, sempre con una parola o un'icona (mai solo la tinta). -->
    <color name="status_info_standard">#7FBDEA</color>
    <!-- status-*-subtle: fondo degli avvisi; l'etichetta e' il colore di stato, il testo e' text-primary. -->
    <color name="status_success_subtle_standard">#15291F</color>
    <color name="status_warning_subtle_standard">#2E2410</color>
    <color name="status_error_subtle_standard">#2A1415</color>
    <color name="status_info_subtle_standard">#14262F</color>
    <!-- state-pressed: il testo primario al 12%, l'overlay delle righe premute col movimento ridotto. -->
    <color name="state_pressed_standard">#1FD1D1D8</color>
    <!-- chart-3, chart-4, chart-5: i lati 1 e 2 sono lime e ciano; questi servono dal terzo dato. -->
    <color name="chart_3">#F0A36B</color>
    <color name="chart_4">#D79BDB</color>
    <color name="chart_5">#A4A9B0</color>

    <!-- Cifre del punteggio e pallino del servizio: il bianco PURO, mai altrove (DESIGN.md, Colori). -->
    <color name="text_on_watch_standard">#FFFFFF</color>
    <!-- background-watch: il nero del gioco sul telefono e del quadrante. -->
    <color name="background_watch_standard">#000000</color>

    <!--
        I velini dietro la navigazione a tre tasti, gli stessi che mette enableEdgeToEdge() della
        piattaforma: bianco al 90% sull'app chiara, grigio quasi nero al 50% sulla scura (Aspetto.kt).
    -->
    <color name="scrim_barre_luminose">#E6FFFFFF</color>
    <color name="scrim_barre_scure">#801B1B1B</color>

    <!--
        CARTA (report PDF, G-8): gli stessi ruoli del tema scuro, nei valori chiari della Constitution.
        Sono alias dei valori del tema chiaro (colors_chiaro.xml): un valore solo, due usi.
        Il PDF esce dal telefono e si stampa: pagina bianca, testo quasi nero, gruppi in un grigio
        appena piu' scuro della carta. Il lime e il ciano di squadra non sono mai testo qui (1,31:1 e
        1,54:1 sul bianco): sono barrette, scurite da TeamInk.graphicOnLight fino a 3:1.
        Contrasti: testo primario 17,08:1 sulla carta e 15,65:1 sul gruppo; secondario 6,43:1 e 5,90:1.
    -->
    <!-- background-canvas su carta. -->
    <color name="background_canvas_print">@color/background_canvas_chiaro</color>
    <!-- background-surface su carta: il gruppo tonale. -->
    <color name="background_surface_print">@color/background_surface_chiaro</color>
    <!-- border-group su carta: la linea sottile fra le righe e il bordo del gruppo (decorativa). -->
    <color name="border_subtle_print">@color/border_subtle_chiaro</color>
    <!-- text-primary su carta. -->
    <color name="text_primary_print">@color/text_primary_chiaro</color>
    <!-- text-secondary su carta: didascalie e stati vuoti. -->
    <color name="text_secondary_print">@color/text_secondary_chiaro</color>

    <!--
        Colori predefiniti delle squadre (G-6, decisione G2): lato 1 lime e lato 2 ciano, gli stessi della
        Cronaca e della dashboard di Padel Elite. Restano personalizzabili: contano solo finche' l'utente
        non sceglie un colore (le preferenze salvano solo la scelta), e TeamInk garantisce il contrasto
        di cio' che sta sopra. I colori Street non ci sono piu': l'ultimo uso, l'icona dell'app, e' passato
        ai token con G-9 (fondo background_canvas_standard, colonne accent_default_standard e text_primary_standard).
    -->
    <color name="team_side_1">@color/accent_default_standard</color>
    <color name="team_side_2">@color/chart_2</color>

    <!--
        Colori di squadra user-1..user-8 (UI Constitution, UserColors; PR 6, bozza B scelta dal
        proprietario il 31 ottobre 2026): gli otto cerchi del dialogo del colore, prima della ruota (che
        resta dietro "Altro colore"). Sono quelli del sistema, nel suo ordine, con un cambio solo: i due
        predefiniti dei lati vengono per primi, e il ciano del lato 2 prende il posto del verde acqua
        (#2EC4B6), della stessa famiglia. Uguali in ogni tema; testo nero sopra (TeamInk), contorno di
        border_strong sulle superfici chiare (i cerchi lo hanno gia').
    -->
    <color name="user_1">@color/team_side_1</color>
    <color name="user_2">@color/team_side_2</color>
    <color name="user_3">#4DA3FF</color>
    <color name="user_4">#FF7A59</color>
    <color name="user_5">#F15BB5</color>
    <color name="user_6">#FFBE0B</color>
    <color name="user_7">#A78BFA</color>
    <color name="user_8">#F2F2F2</color>
</resources>
