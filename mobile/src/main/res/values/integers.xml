<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Durate della UI Constitution (DESIGN.md, Mappatura dei ruoli), in millisecondi. Nessuna
        animazione del contorno dura piu' di duration_standard. duration-expressive (380) non si usa.
    -->
    <!-- duration-instant: la pressione di ogni comando. -->
    <integer name="duration_instant">100</integer>
    <!-- duration-fast: dissolvenze brevi, un cambio di testo. -->
    <integer name="duration_fast">160</integer>
    <!-- duration-standard: apertura di un dialogo o di un foglio, il segno di spunta. -->
    <integer name="duration_standard">240</integer>

    <!--
        Quanto resta un messaggio con "Annulla" (Serata, "Usa i presenti" e i gironi). Non e' un'animazione:
        e' il tempo per ripensarci, piu' lungo della durata lunga di sistema (circa 3 secondi) perche' a bordo
        campo il telefono si guarda di sfuggita. Con TalkBack Material lo allunga ancora se serve.
    -->
    <integer name="undo_window">8000</integer>
</resources>
