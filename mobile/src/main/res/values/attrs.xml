<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Lo StateListAnimator della pressione (scala e opacita'): lo risolve il tema, cosi' con
        l'animazione ridotta del sistema ThemeOverlay.App.MovimentoRidotto lo sostituisce con la
        sola opacita'. Gli stili dei controlli lo citano con ?attr/pressFeedback.
    -->
    <attr name="pressFeedback" format="reference" />
    <attr name="colorBackgroundCanvas" format="color" />
    <attr name="colorBackgroundSurface" format="color" />
    <attr name="colorBackgroundElevated" format="color" />
    <attr name="colorStateHover" format="color" />
    <attr name="colorBorderGroup" format="color" />
    <attr name="colorBorderSubtle" format="color" />
    <attr name="colorBorderStrong" format="color" />
    <attr name="colorTextPrimary" format="color" />
    <attr name="colorTextSecondary" format="color" />
    <attr name="colorTextDisabled" format="color" />
    <attr name="colorOnAccent" format="color" />
    <attr name="colorStatusWarning" format="color" />
    <attr name="colorStatusError" format="color" />
    <attr name="colorStatusInfo" format="color" />
    <attr name="colorStatusSuccessSubtle" format="color" />
    <attr name="colorStatusWarningSubtle" format="color" />
    <attr name="colorStatusErrorSubtle" format="color" />
    <attr name="colorStatusInfoSubtle" format="color" />
    <attr name="colorStatePressed" format="color" />
    <attr name="colorFocusRing" format="color" />
    <!-- L'accento: lime sul nero, un verde oliva scuro sul chiaro (il lime su bianco fa 1,3:1). -->
    <attr name="colorAccentDefault" format="color" />
    <!-- Il fondo e l'inchiostro del gioco: nero e bianco nel tema scuro, bianco e quasi nero nel chiaro. -->
    <attr name="colorBackgroundWatch" format="color" />
    <attr name="colorTextOnWatch" format="color" />

    <!--
        Lo stato vuoto (G-4): che cosa e' vuoto, perche', che fare. L'azione e' facoltativa, ma una
        schermata vuota senza una strada davanti non dice abbastanza.
    -->
    <declare-styleable name="EmptyStateView">
        <attr name="emptyIcon" format="reference" />
        <attr name="emptyTitle" format="string" />
        <attr name="emptyReason" format="string" />
        <attr name="emptyAction" format="string" />
    </declare-styleable>

    <!-- TestoCheSiStringe: la misura piu' piccola, e per i nomi e la striscia le due righe e la loro misura massima. -->
    <declare-styleable name="TestoCheSiStringe">
        <attr name="minimo" format="dimension" />
        <attr name="aCapoSeNonBasta" format="boolean" />
        <attr name="massimoADueRighe" format="dimension" />
    </declare-styleable>
</resources>
