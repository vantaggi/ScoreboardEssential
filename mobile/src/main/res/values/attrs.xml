<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Lo StateListAnimator della pressione (scala e opacita'): lo risolve il tema, cosi' con
        l'animazione ridotta del sistema ThemeOverlay.App.MovimentoRidotto lo sostituisce con la
        sola opacita'. Gli stili dei controlli lo citano con ?attr/pressFeedback.
    -->
    <attr name="pressFeedback" format="reference" />
    <attr name="eliteBackground" format="color" />
    <attr name="eliteSurface" format="color" />
    <attr name="eliteSurfaceRaised" format="color" />
    <attr name="eliteSurfaceHover" format="color" />
    <attr name="eliteBorder" format="color" />
    <attr name="eliteBorderStrong" format="color" />
    <attr name="eliteOutline" format="color" />
    <attr name="eliteTextPrimary" format="color" />
    <attr name="eliteTextSecondary" format="color" />
    <attr name="eliteTextDisabled" format="color" />
    <attr name="eliteOnLime" format="color" />
    <attr name="eliteWarning" format="color" />
    <attr name="eliteError" format="color" />
    <attr name="eliteInfo" format="color" />
    <attr name="eliteSuccessSubtle" format="color" />
    <attr name="eliteWarningSubtle" format="color" />
    <attr name="eliteErrorSubtle" format="color" />
    <attr name="eliteInfoSubtle" format="color" />
    <attr name="eliteStatePressed" format="color" />
    <attr name="eliteFocusRing" format="color" />
    <!-- L'accento: lime sul nero, un verde oliva scuro sul chiaro (il lime su bianco fa 1,3:1). -->
    <attr name="eliteAccent" format="color" />
    <!-- Il fondo e l'inchiostro del gioco: nero e bianco nel tema scuro, bianco e quasi nero nel chiaro. -->
    <attr name="eliteGameBackground" format="color" />
    <attr name="eliteGameInk" format="color" />

    <!--
        Lo stato vuoto (G-4): che cosa e' vuoto, perche', che fare. L'azione e' facoltativa, ma una
        schermata vuota senza una strada davanti non dice abbastanza.
    -->
    <declare-styleable name="EmptyStateView">
        <attr name="emptyIcon" format="reference" />
        <attr name="emptyTitle" format="string" />
        <attr name="emptyReason" format="string" />
        <attr name="emptyAction" format="string" />
    </declare-styleable>
</resources>
