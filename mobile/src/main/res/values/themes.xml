<resources>
    <!-- Base application theme. -->
    <!--
        Base SCURA, non DayNight.

        L'app dipinge asfalto e cemento in ogni caso: non ha mai seguito il tema di sistema, e
        dichiarare DayNight era una promessa che non manteneva. Su un dispositivo in modalita'
        chiara quel parent risolveva alla base Light, e da li' arrivava android:textColorPrimary
        SCURO, che il tema non sovrascriveva. Risultato visto su emulatore: nelle impostazioni
        i valori dei campi (nome squadra, secondi del portiere, lingua, sport) erano testo scuro
        su card scure, praticamente illeggibili.

        Le sovrascritture di Material3 (colorSurface, colorOnSurface...) c'erano gia' ed erano
        giuste: il buco stava nei colori del FRAMEWORK, che TextInputEditText usa per il testo
        digitato. Cambiare base li sistema tutti in una volta invece di rincorrerli uno per uno.
    -->
    <style name="Theme.ScoreboardEssential" parent="Theme.Material3.Dark.NoActionBar">
        <!--
            Colori di Padel Elite (DESIGN.md, pista "Coerenza con Padel Elite", G-0). Il lime e' l'unico
            accento: sopra il lime il testo e' il fondo #0D0D0F (14,9:1), mai il bianco (1,3:1). Il ciano
            della dashboard vive solo nei grafici e non ha un ruolo qui: un secondo accento nel contorno
            sarebbe un'invenzione dell'app.
        -->
        <item name="colorPrimary">@color/elite_lime</item>
        <item name="colorOnPrimary">@color/elite_on_lime</item>
        <!-- Il secondario e' neutro, come il bottone secondario della dashboard. -->
        <item name="colorSecondary">@color/elite_text_secondary</item>
        <item name="colorOnSecondary">@color/elite_background</item>
        <item name="colorError">@color/elite_error</item>
        <item name="colorOnError">@color/elite_background</item>
        <item name="android:colorBackground">@color/elite_background</item>
        <item name="colorSurface">@color/elite_surface</item>
        <item name="colorOnSurface">@color/elite_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/elite_text_secondary</item>

        <!--
            Mappatura COMPLETA dei ruoli di Material 3 (DESIGN.md, Contorno: tema e dialoghi).
            Un ruolo lasciato fuori prende il valore base di M3, che e' viola: avatar delle rose,
            sfondo dei dialoghi, bordi dei campi. Qui ogni ruolo ha un token del progetto e il
            test TemaDelTelefonoTest controlla che nessuno sia viola. Il tema resta solo scuro (G4).
        -->
        <item name="colorOnBackground">@color/elite_text_primary</item>
        <item name="colorPrimaryContainer">@color/elite_surface_raised</item>
        <item name="colorOnPrimaryContainer">@color/elite_text_primary</item>
        <item name="colorSecondaryContainer">@color/elite_surface_raised</item>
        <item name="colorOnSecondaryContainer">@color/elite_text_primary</item>
        <!-- Terzo accento: non esiste in Padel Elite, il ruolo segue il testo primario. -->
        <item name="colorTertiary">@color/elite_text_primary</item>
        <item name="colorOnTertiary">@color/elite_background</item>
        <item name="colorTertiaryContainer">@color/elite_surface_raised</item>
        <item name="colorOnTertiaryContainer">@color/elite_text_primary</item>
        <item name="colorErrorContainer">@color/elite_surface</item>
        <item name="colorOnErrorContainer">@color/elite_error</item>
        <item name="colorSurfaceVariant">@color/elite_surface_raised</item>
        <item name="colorSurfaceDim">@color/elite_background</item>
        <item name="colorSurfaceBright">@color/elite_surface_hover</item>
        <item name="colorSurfaceContainerLowest">@color/elite_background</item>
        <item name="colorSurfaceContainerLow">@color/elite_surface</item>
        <item name="colorSurfaceContainer">@color/elite_surface</item>
        <item name="colorSurfaceContainerHigh">@color/elite_surface_raised</item>
        <item name="colorSurfaceContainerHighest">@color/elite_surface_raised</item>
        <!-- Contorno dei comandi: elite_outline (3:1), non il bordo della dashboard (1,4:1). -->
        <item name="colorOutline">@color/elite_outline</item>
        <item name="colorOutlineVariant">@color/elite_border_strong</item>
        <!-- Superficie e inchiostro invertiti (snackbar): chiaro su scuro, con l'azione sul fondo. -->
        <item name="colorSurfaceInverse">@color/elite_text_primary</item>
        <item name="colorOnSurfaceInverse">@color/elite_background</item>
        <item name="colorPrimaryInverse">@color/elite_background</item>
        <!-- Ruoli fissi: nessun layout li usa, ma il primo componente nuovo li userebbe viola. -->
        <item name="colorPrimaryFixed">@color/elite_lime</item>
        <item name="colorPrimaryFixedDim">@color/elite_lime</item>
        <item name="colorOnPrimaryFixed">@color/elite_on_lime</item>
        <item name="colorOnPrimaryFixedVariant">@color/elite_on_lime</item>
        <item name="colorSecondaryFixed">@color/elite_text_secondary</item>
        <item name="colorSecondaryFixedDim">@color/elite_text_secondary</item>
        <item name="colorOnSecondaryFixed">@color/elite_background</item>
        <item name="colorOnSecondaryFixedVariant">@color/elite_background</item>
        <item name="colorTertiaryFixed">@color/elite_text_primary</item>
        <item name="colorTertiaryFixedDim">@color/elite_text_secondary</item>
        <item name="colorOnTertiaryFixed">@color/elite_background</item>
        <item name="colorOnTertiaryFixedVariant">@color/elite_background</item>

        <!-- Tutti i dialoghi, anche quelli costruiti senza overlay esplicito. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>

        <!--
            Caratteri (DESIGN.md, G-1): Inter per il testo. Tutta la scala di Material 3 e' ripuntata
            su Inter qui sotto. Niente android:fontFamily nel tema: la vista lo legge DOPO il suo
            textAppearance e lo sovrascriverebbe (il punteggio perderebbe le cifre tabulari).
        -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.DisplayLarge.Street</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.App.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.HeadlineMedium.Street</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge.Street</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.LabelSmall</item>

        <!--
            Forme (G-2): tutte arrotondate, sui raggi della Constitution. small = controlli (8dp),
            medium = gruppi e card (14dp), large = dialoghi e fogli (14dp). Via le forme tagliate.
        -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Control</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Surface</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.Overlay</item>

        <!--
            Componenti (G-2): gli stili del contorno sono i predefiniti del tema, cosi' un bottone, un
            campo o una card senza stile esplicito non ricadono sul M3 di fabbrica (pillole, ombre).
            Un solo primario per regione: il primario e' lo stile base, il secondario e' l'outlined.
        -->
        <item name="materialButtonStyle">@style/Widget.App.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Secondary</item>
        <item name="borderlessButtonStyle">@style/Widget.App.Button.Text</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="checkboxStyle">@style/Widget.App.CheckBox</item>
        <item name="radioButtonStyle">@style/Widget.App.RadioButton</item>
        <item name="materialSwitchStyle">@style/Widget.App.Switch</item>

        <!-- La pressione di ogni controllo (animator/press_feedback.xml); il movimento ridotto la sostituisce. -->
        <item name="pressFeedback">@animator/press_feedback</item>
    </style>

    <!--
        Movimento ridotto (ANIMATOR_DURATION_SCALE = 0): la pressione perde la scala e tiene la sola
        opacita'. Lo applica MovimentoRidotto.kt a ogni activity prima che gonfi i layout.
    -->
    <style name="ThemeOverlay.App.MovimentoRidotto" parent="">
        <item name="pressFeedback">@animator/press_feedback_reduced</item>
    </style>

    <!--
        Tipografia del contorno (G-1, G-1b). Inter ovunque c'e' testo: i pesi vengono dai ruoli di M3
        (textFontWeight) e sono tre, 400, 500 e 600 (UI Constitution); il grassetto e' il 600. Il
        carattere e' quello di res/font. I tre stili "Street" tengono il nome perche' li citano
        layout e test; il maiuscolo e la spaziatura sono quelli di prima.
    -->
    <style name="TextAppearance.App.DisplayLarge.Street" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="TextAppearance.App.HeadlineMedium.Street" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextAppearance.App.BodyLarge.Street" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <!--
        Il punteggio del contorno (storico, statistiche, Cronaca, foglio): Inter 600 con cifre
        tabulari (tnum), cosi' le colonne di numeri stanno in fila. Il padre e' il TextAppearance
        di base e non uno di M3: M3 porta con se' un'altezza di riga fissa che taglierebbe un 32sp.
        Corpo e colore li dice la vista; un tempo piccolo chiede textFontWeight 500.
    -->
    <style name="TextAppearance.App.Punteggio" parent="android:TextAppearance">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!--
        Forme della UI Constitution (DESIGN.md, ruoli radius-*). Tutte rounded: i raggi vengono da
        dimens.xml. Il foglio PARTITA ha il raggio dei gruppi solo in alto, sotto resta attaccato al bordo.
    -->
    <style name="ShapeAppearance.App.Control" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_control</item>
    </style>
    <style name="ShapeAppearance.App.Surface" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_surface</item>
    </style>
    <style name="ShapeAppearance.App.Overlay" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_overlay</item>
    </style>
    <style name="ShapeAppearance.App.Badge" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_badge</item>
    </style>
    <style name="ShapeAppearance.App.MatchSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_surface</item>
        <item name="cornerSizeTopRight">@dimen/radius_surface</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <!-- Nomi di prima: li citano ancora il foglio e la schermata di gioco (G-6 li toglie); ora sono le forme nuove. -->
    <style name="ShapeAppearance.App.StreetCard" parent="ShapeAppearance.App.Surface" />
    <style name="ShapeAppearance.App.StreetButton" parent="ShapeAppearance.App.Control" />
    <style name="ShapeAppearance.App.StreetBadge" parent="ShapeAppearance.App.Badge" />

    <!--
        La tipografia della schermata di gioco (DESIGN.md, Tipografia). Il numero non ha una
        dimensione qui: la calcola MainActivity una volta per sport, in pixel. Il colore delle
        cifre e' il bianco puro; le altre righe lo impostano nel layout.
    -->
    <style name="TextAppearance.App.Game.Score" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textSize">@dimen/score_text_max</item>
        <item name="android:textColor">@color/ink_white</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <!-- Cifre tabulari: il tempo non si allarga a ogni secondo. -->
    <style name="TextAppearance.App.Game.Clock" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.App.Game.Value" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.App.Game.Name" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/stencil_white</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
    <style name="TextAppearance.App.Game.Command" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
    <style name="TextAppearance.App.Game.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/sidewalk_gray</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- Testo dei bottoni: Inter 600, senza maiuscolo forzato (i bottoni dicono l'azione). -->
    <style name="TextAppearance.App.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <!--
        Dialoghi (G-2): raggio radius-overlay, fondo rialzato, scrim nero all'85%. L'overlay e' il
        materialAlertDialogTheme del tema; la forma del builder M3 passa da shapeAppearanceCornerExtraLarge.
    -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/elite_lime</item>
        <item name="colorSurface">@color/elite_surface_raised</item>
        <item name="colorOnSurface">@color/elite_text_primary</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.App.Overlay</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.App.Dialog</item>
    </style>

    <style name="ThemeOverlay.App.Dialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_overlay</item>
        <item name="dialogCornerRadius">@dimen/radius_overlay</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">@dimen/scrim_dim_amount</item>
    </style>
</resources>
