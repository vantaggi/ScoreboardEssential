<resources>
    <!-- Base application theme. -->
    <!--
        Base SCURA, non DayNight.

        L'app dipinge asfalto e cemento in ogni caso: non ha mai seguito il tema di sistema, e
        dichiarare DayNight era una promessa che non manteneva. Su un dispositivo in modalita'
        chiara quel parent risolveva alla base Light, e da li' arrivava android:textColorPrimary
        SCURO, che il tema non sovrascriveva. Risultato visto su emulatore: nelle impostazioni
        i valori dei campi (nome squadra, secondi del portiere, lingua, sport) erano testo scuro
        su card scure, praticamente illeggibili.

        Le sovrascritture di Material3 (colorSurface, colorOnSurface...) c'erano gia' ed erano
        giuste: il buco stava nei colori del FRAMEWORK, che TextInputEditText usa per il testo
        digitato. Cambiare base li sistema tutti in una volta invece di rincorrerli uno per uno.
    -->
    <style name="Theme.ScoreboardEssential" parent="Theme.Material3.Dark.NoActionBar">
        <!--
            Ruoli che il tema ad alto contrasto (G-10) cambia: ogni token elite_* e' un file in res/color che
            punta a questi attributi, quindi layout e codice continuano a citare @color/elite_x e seguono il
            tema. Qui i valori standard; ThemeOverlay.App.AltoContrasto assegna quelli ad alto contrasto.
        -->
        <item name="colorBackgroundCanvas">@color/background_canvas_standard</item>
        <item name="colorBackgroundSurface">@color/background_surface_standard</item>
        <item name="colorBackgroundElevated">@color/background_elevated_standard</item>
        <item name="colorStateHover">@color/state_hover_standard</item>
        <item name="colorBorderGroup">@color/border_group_standard</item>
        <item name="colorBorderSubtle">@color/border_subtle_standard</item>
        <item name="colorBorderStrong">@color/border_strong_standard</item>
        <item name="colorTextPrimary">@color/text_primary_standard</item>
        <item name="colorTextSecondary">@color/text_secondary_standard</item>
        <item name="colorTextDisabled">@color/text_disabled_standard</item>
        <item name="colorOnAccent">@color/on_accent_standard</item>
        <item name="colorStatusWarning">@color/status_warning_standard</item>
        <item name="colorStatusError">@color/status_error_standard</item>
        <item name="colorStatusInfo">@color/status_info_standard</item>
        <item name="colorStatusSuccessSubtle">@color/status_success_subtle_standard</item>
        <item name="colorStatusWarningSubtle">@color/status_warning_subtle_standard</item>
        <item name="colorStatusErrorSubtle">@color/status_error_subtle_standard</item>
        <item name="colorStatusInfoSubtle">@color/status_info_subtle_standard</item>
        <item name="colorStatePressed">@color/state_pressed_standard</item>
        <item name="colorFocusRing">@color/focus_ring_standard</item>
        <item name="colorAccentDefault">@color/accent_default_standard</item>
        <item name="colorBackgroundWatch">@color/background_watch_standard</item>
        <item name="colorTextOnWatch">@color/text_on_watch_standard</item>
        <!--
            Colori di Padel Elite (DESIGN.md, pista "Coerenza con Padel Elite", G-0). Il lime e' l'unico
            accento: sopra il lime il testo e' il fondo #0D0D0F (14,9:1), mai il bianco (1,3:1). Il ciano
            della dashboard vive solo nei grafici e non ha un ruolo qui: un secondo accento nel contorno
            sarebbe un'invenzione dell'app.
        -->
        <item name="colorPrimary">?attr/colorAccentDefault</item>
        <item name="colorOnPrimary">?attr/colorOnAccent</item>
        <!-- Il secondario e' neutro, come il bottone secondario della dashboard. -->
        <item name="colorSecondary">?attr/colorTextSecondary</item>
        <item name="colorOnSecondary">?attr/colorBackgroundCanvas</item>
        <item name="colorError">?attr/colorStatusError</item>
        <item name="colorOnError">?attr/colorBackgroundCanvas</item>
        <item name="android:colorBackground">?attr/colorBackgroundCanvas</item>
        <item name="colorSurface">?attr/colorBackgroundSurface</item>
        <item name="colorOnSurface">?attr/colorTextPrimary</item>
        <item name="colorOnSurfaceVariant">?attr/colorTextSecondary</item>
        <!--
            Niente tinta di elevazione (G-3). Material 3 mescola colorPrimary nelle superfici sollevate
            (dialoghi, fogli, card): con il lime il fondo del dialogo diventava verde oliva invece di
            background-elevated (#1E1E22). Le superfici si alzano di tono coi token, mai di tinta; lo
            ripetono gli overlay dei dialoghi, che hanno il loro tema.
        -->
        <item name="elevationOverlayEnabled">false</item>

        <!--
            Mappatura COMPLETA dei ruoli di Material 3 (DESIGN.md, Contorno: tema e dialoghi).
            Un ruolo lasciato fuori prende il valore base di M3, che e' viola: avatar delle rose,
            sfondo dei dialoghi, bordi dei campi. Qui ogni ruolo ha un token del progetto e il
            test TemaDelTelefonoTest controlla che nessuno sia viola. Il tema resta solo scuro (G4).
        -->
        <item name="colorOnBackground">?attr/colorTextPrimary</item>
        <item name="colorPrimaryContainer">?attr/colorBackgroundElevated</item>
        <item name="colorOnPrimaryContainer">?attr/colorTextPrimary</item>
        <item name="colorSecondaryContainer">?attr/colorBackgroundElevated</item>
        <item name="colorOnSecondaryContainer">?attr/colorTextPrimary</item>
        <!-- Terzo accento: non esiste in Padel Elite, il ruolo segue il testo primario. -->
        <item name="colorTertiary">?attr/colorTextPrimary</item>
        <item name="colorOnTertiary">?attr/colorBackgroundCanvas</item>
        <item name="colorTertiaryContainer">?attr/colorBackgroundElevated</item>
        <item name="colorOnTertiaryContainer">?attr/colorTextPrimary</item>
        <item name="colorErrorContainer">?attr/colorBackgroundSurface</item>
        <item name="colorOnErrorContainer">?attr/colorStatusError</item>
        <item name="colorSurfaceVariant">?attr/colorBackgroundElevated</item>
        <item name="colorSurfaceDim">?attr/colorBackgroundCanvas</item>
        <item name="colorSurfaceBright">?attr/colorStateHover</item>
        <item name="colorSurfaceContainerLowest">?attr/colorBackgroundCanvas</item>
        <item name="colorSurfaceContainerLow">?attr/colorBackgroundSurface</item>
        <item name="colorSurfaceContainer">?attr/colorBackgroundSurface</item>
        <item name="colorSurfaceContainerHigh">?attr/colorBackgroundElevated</item>
        <item name="colorSurfaceContainerHighest">?attr/colorBackgroundElevated</item>
        <!-- Contorno dei comandi: border_strong (3:1), non il bordo della dashboard (1,4:1). -->
        <item name="colorOutline">?attr/colorBorderStrong</item>
        <item name="colorOutlineVariant">?attr/colorBorderSubtle</item>
        <!-- Superficie e inchiostro invertiti (snackbar): chiaro su scuro, con l'azione sul fondo. -->
        <item name="colorSurfaceInverse">?attr/colorTextPrimary</item>
        <item name="colorOnSurfaceInverse">?attr/colorBackgroundCanvas</item>
        <item name="colorPrimaryInverse">?attr/colorBackgroundCanvas</item>
        <!-- Ruoli fissi: nessun layout li usa, ma il primo componente nuovo li userebbe viola. -->
        <item name="colorPrimaryFixed">?attr/colorAccentDefault</item>
        <item name="colorPrimaryFixedDim">?attr/colorAccentDefault</item>
        <item name="colorOnPrimaryFixed">?attr/colorOnAccent</item>
        <item name="colorOnPrimaryFixedVariant">?attr/colorOnAccent</item>
        <item name="colorSecondaryFixed">?attr/colorTextSecondary</item>
        <item name="colorSecondaryFixedDim">?attr/colorTextSecondary</item>
        <item name="colorOnSecondaryFixed">?attr/colorBackgroundCanvas</item>
        <item name="colorOnSecondaryFixedVariant">?attr/colorBackgroundCanvas</item>
        <item name="colorTertiaryFixed">?attr/colorTextPrimary</item>
        <item name="colorTertiaryFixedDim">?attr/colorTextSecondary</item>
        <item name="colorOnTertiaryFixed">?attr/colorBackgroundCanvas</item>
        <item name="colorOnTertiaryFixedVariant">?attr/colorBackgroundCanvas</item>

        <!-- Tutti i dialoghi, anche quelli costruiti senza overlay esplicito. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog</item>

        <!--
            Caratteri (DESIGN.md, G-1): Inter per il testo. Tutta la scala di Material 3 e' ripuntata
            su Inter qui sotto. Niente android:fontFamily nel tema: la vista lo legge DOPO il suo
            textAppearance e lo sovrascriverebbe (il punteggio perderebbe le cifre tabulari).
        -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.App.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.LabelSmall</item>

        <!--
            Forme (G-2): tutte arrotondate, sui raggi della Constitution. small = controlli (8dp),
            medium = gruppi e card (14dp), large = dialoghi e fogli (14dp). Via le forme tagliate.
        -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Control</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Surface</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.Overlay</item>

        <!--
            Componenti (G-2): gli stili del contorno sono i predefiniti del tema, cosi' un bottone, un
            campo o una card senza stile esplicito non ricadono sul M3 di fabbrica (pillole, ombre).
            Un solo primario per regione: il primario e' lo stile base, il secondario e' l'outlined.
        -->
        <item name="materialButtonStyle">@style/Widget.App.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Secondary</item>
        <item name="borderlessButtonStyle">@style/Widget.App.Button.Text</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="checkboxStyle">@style/Widget.App.CheckBox</item>
        <item name="radioButtonStyle">@style/Widget.App.RadioButton</item>
        <item name="materialSwitchStyle">@style/Widget.App.Switch</item>

        <!-- La pressione di ogni controllo (animator/press_feedback.xml); il movimento ridotto la sostituisce. -->
        <item name="pressFeedback">@animator/press_feedback</item>
    </style>

    <!--
        Movimento ridotto (ANIMATOR_DURATION_SCALE = 0): la pressione perde la scala e tiene la sola
        opacita'. Lo applica MovimentoRidotto.kt a ogni activity prima che gonfi i layout.
    -->
    <style name="ThemeOverlay.App.MovimentoRidotto" parent="">
        <item name="pressFeedback">@animator/press_feedback_reduced</item>
    </style>
    <!--
        Tema chiaro (scelta Aspetto, DESIGN.md "Tema chiaro"): un tema AGGIUNTO che cambia i colori dei ruoli e i pochi
        colori del framework che la base scura fissa al bianco (testo dei campi, icone di sistema). Forme, pesi e
        movimento non si toccano. Lo applica Aspetto.kt a ogni activity prima che gonfi i layout; l'alto contrasto e'
        solo scuro, quindi con l'alto contrasto acceso il chiaro non si applica. I valori sono in colors_chiaro.xml.
    -->
    <style name="ThemeOverlay.App.Chiaro" parent="">
        <item name="colorBackgroundCanvas">@color/background_canvas_chiaro</item>
        <item name="colorBackgroundSurface">@color/background_surface_chiaro</item>
        <item name="colorBackgroundElevated">@color/background_elevated_chiaro</item>
        <item name="colorStateHover">@color/state_hover_chiaro</item>
        <item name="colorBorderGroup">@color/border_group_chiaro</item>
        <item name="colorBorderSubtle">@color/border_subtle_chiaro</item>
        <item name="colorBorderStrong">@color/border_strong_chiaro</item>
        <item name="colorTextPrimary">@color/text_primary_chiaro</item>
        <item name="colorTextSecondary">@color/text_secondary_chiaro</item>
        <item name="colorTextDisabled">@color/text_disabled_chiaro</item>
        <item name="colorOnAccent">@color/on_accent_chiaro</item>
        <item name="colorStatusWarning">@color/status_warning_chiaro</item>
        <item name="colorStatusError">@color/status_error_chiaro</item>
        <item name="colorStatusInfo">@color/status_info_chiaro</item>
        <item name="colorStatusSuccessSubtle">@color/status_success_subtle_chiaro</item>
        <item name="colorStatusWarningSubtle">@color/status_warning_subtle_chiaro</item>
        <item name="colorStatusErrorSubtle">@color/status_error_subtle_chiaro</item>
        <item name="colorStatusInfoSubtle">@color/status_info_subtle_chiaro</item>
        <item name="colorStatePressed">@color/state_pressed_chiaro</item>
        <item name="colorFocusRing">@color/focus_ring_chiaro</item>
        <item name="colorAccentDefault">@color/accent_default_chiaro</item>
        <item name="colorBackgroundWatch">@color/background_watch_chiaro</item>
        <item name="colorTextOnWatch">@color/text_on_watch_chiaro</item>
        <!-- I colori del framework che la base scura fissa chiari: senza questi i campi scrivono bianco su bianco. -->
        <item name="android:textColorPrimary">?attr/colorTextPrimary</item>
        <item name="android:textColorSecondary">?attr/colorTextSecondary</item>
        <item name="android:textColorTertiary">?attr/colorTextSecondary</item>
        <item name="android:textColorHint">?attr/colorTextSecondary</item>
        <item name="android:textColorPrimaryInverse">?attr/colorBackgroundCanvas</item>
        <item name="android:textColorSecondaryInverse">?attr/colorBackgroundCanvas</item>
        <item name="android:colorForeground">?attr/colorTextPrimary</item>
        <item name="android:colorForegroundInverse">?attr/colorBackgroundCanvas</item>
        <item name="android:isLightTheme">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- I dialoghi nascono dal materialAlertDialogTheme: la base del dialogo scuro non basta. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.MaterialAlertDialog.Chiaro</item>
    </style>
    <!--
        Alto contrasto (G-10): un tema AGGIUNTO, scuro, che cambia solo i colori dei ruoli (testo a 7:1, bordi e
        icone a 3:1). Forme, pesi, raggi e movimento non si toccano: questo overlay non ne ha nessuno. Lo applica
        AltoContrasto.kt a ogni activity prima che gonfi i layout, per scelta dell'utente o seguendo il contrasto
        di sistema. I valori sono in colors_alto_contrasto.xml.
    -->
    <style name="ThemeOverlay.App.AltoContrasto" parent="">
        <item name="colorBackgroundCanvas">@color/background_canvas_alto_contrasto</item>
        <item name="colorBackgroundSurface">@color/background_surface_alto_contrasto</item>
        <item name="colorBackgroundElevated">@color/background_elevated_alto_contrasto</item>
        <item name="colorStateHover">@color/state_hover_alto_contrasto</item>
        <item name="colorBorderGroup">@color/border_group_alto_contrasto</item>
        <item name="colorBorderSubtle">@color/border_subtle_alto_contrasto</item>
        <item name="colorBorderStrong">@color/border_strong_alto_contrasto</item>
        <item name="colorTextPrimary">@color/text_primary_alto_contrasto</item>
        <item name="colorTextSecondary">@color/text_secondary_alto_contrasto</item>
        <item name="colorTextDisabled">@color/text_disabled_alto_contrasto</item>
        <item name="colorOnAccent">@color/on_accent_alto_contrasto</item>
        <item name="colorStatusWarning">@color/status_warning_alto_contrasto</item>
        <item name="colorStatusError">@color/status_error_alto_contrasto</item>
        <item name="colorStatusInfo">@color/status_info_alto_contrasto</item>
        <item name="colorStatusSuccessSubtle">@color/status_success_subtle_alto_contrasto</item>
        <item name="colorStatusWarningSubtle">@color/status_warning_subtle_alto_contrasto</item>
        <item name="colorStatusErrorSubtle">@color/status_error_subtle_alto_contrasto</item>
        <item name="colorStatusInfoSubtle">@color/status_info_subtle_alto_contrasto</item>
        <item name="colorStatePressed">@color/state_pressed_alto_contrasto</item>
        <item name="colorFocusRing">@color/focus_ring_alto_contrasto</item>
    </style>


    <!--
        Tipografia del contorno (G-1, G-1b). Inter ovunque c'e' testo: i pesi vengono dai ruoli di M3
        (textFontWeight) e sono tre, 400, 500 e 600 (UI Constitution); il grassetto e' il 600. Il
        carattere e' quello di res/font. DisplayLarge, HeadlineMedium e BodyLarge si chiamavano "Street" e
        hanno perso il suffisso con G-9 (il tema li cita; DisplayLarge non si usa negli strumenti).
    -->
    <style name="TextAppearance.App.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="TextAppearance.App.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="TextAppearance.App.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="TextAppearance.App.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <!--
        Ruoli di testo del contorno (G-4), sulla scala di M3 e sui tre pesi. section-heading: il titolo
        della schermata e dei suoi gruppi, 600. row-title: il testo principale di una riga, 500.
        caption: il dato che spiega, 400 in text-secondary. Il colore lo da' il tema o la vista.
    -->
    <style name="TextAppearance.App.SectionHeading" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.App.RowTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <!-- Il titolo di una riga selezionata (Serata): stesso corpo, peso 600. E' il secondo segno della selezione. -->
    <style name="TextAppearance.App.RowTitleSelected" parent="TextAppearance.App.RowTitle">
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!--
        Il punteggio del contorno (storico, statistiche, Cronaca, foglio): Inter 600 con cifre
        tabulari (tnum), cosi' le colonne di numeri stanno in fila. Il padre e' il TextAppearance
        di base e non uno di M3: M3 porta con se' un'altezza di riga fissa che taglierebbe un 32sp.
        Corpo e colore li dice la vista; un tempo piccolo chiede textFontWeight 500.
    -->
    <style name="TextAppearance.App.Punteggio" parent="android:TextAppearance">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!--
        Forme della UI Constitution (DESIGN.md, ruoli radius-*). Tutte rounded: i raggi vengono da
        dimens.xml. Il foglio PARTITA ha il raggio dei gruppi solo in alto, sotto resta attaccato al bordo.
    -->
    <style name="ShapeAppearance.App.Control" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_control</item>
    </style>
    <style name="ShapeAppearance.App.Surface" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_surface</item>
    </style>
    <style name="ShapeAppearance.App.Overlay" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_overlay</item>
    </style>
    <style name="ShapeAppearance.App.Badge" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_badge</item>
    </style>
    <!-- Il campione di un colore (squadra): un cerchio, che non si confonde coi bottoni rettangolari. -->
    <style name="ShapeAppearance.App.Swatch" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearance.App.MatchSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_surface</item>
        <item name="cornerSizeTopRight">@dimen/radius_surface</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!--
        La tipografia della schermata di gioco (DESIGN.md, Tipografia; G-6). Tutta in Inter, nei tre pesi
        della Constitution: 600 per i numeri (punteggio, tempo, valori), 500 per il nome e i comandi,
        400 per le didascalie. Nessun maiuscolo forzato (le squadre si scrivono come l'utente le ha
        scritte) e nessuna spaziatura da titolo. Il numero non ha una dimensione qui: la calcola
        MainActivity una volta per sport, in pixel. Il colore delle cifre e' il bianco puro; le altre
        righe lo impostano nel layout.

        letterSpacing -0,02 em sulle cifre giganti: con Inter tabulare "AV" e' il token piu' largo e
        faceva scendere le cifre del padel e del tennis; la spaziatura stretta le riporta in alto
        (misure in DESIGN.md, G-6).
    -->
    <style name="TextAppearance.App.Game.Score" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textSize">@dimen/score_text_max</item>
        <item name="android:textColor">@color/text_on_watch</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <!-- Cifre tabulari: il tempo non si allarga a ogni secondo. Inter 600, come il punteggio. -->
    <style name="TextAppearance.App.Game.Clock" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.App.Game.Value" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.App.Game.Name" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.App.Game.Command" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.App.Game.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Testo dei bottoni: Inter 600, senza maiuscolo forzato (i bottoni dicono l'azione). -->
    <style name="TextAppearance.App.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <!--
        Dialoghi (G-2): raggio radius-overlay, fondo rialzato, scrim nero all'85%. L'overlay e' il
        materialAlertDialogTheme del tema; la forma del builder M3 passa da shapeAppearanceCornerExtraLarge.
    -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">?attr/colorAccentDefault</item>
        <item name="colorSurface">?attr/colorBackgroundElevated</item>
        <item name="colorOnSurface">?attr/colorTextPrimary</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.App.Overlay</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.App.Dialog</item>
    </style>

    <style name="ThemeOverlay.App.MaterialAlertDialog.Chiaro" parent="ThemeOverlay.App.MaterialAlertDialog">
        <item name="alertDialogTheme">@style/ThemeOverlay.App.Dialog.Chiaro</item>
    </style>

    <style name="ThemeOverlay.App.Dialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:windowBackground">@drawable/bg_overlay</item>
        <item name="dialogCornerRadius">@dimen/radius_overlay</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">@dimen/scrim_dim_amount</item>
    </style>

    <!-- Il dialogo del tema chiaro: stessa forma e stesso velo, base chiara per i colori del framework. -->
    <style name="ThemeOverlay.App.Dialog.Chiaro" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:windowBackground">@drawable/bg_overlay</item>
        <item name="dialogCornerRadius">@dimen/radius_overlay</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">@dimen/scrim_dim_amount</item>
    </style>
</resources>
