<?xml version="1.0" encoding="utf-8"?>
<!-- Chip: testo primario, lime se selezionato, disattivo con text-disabled. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/elite_text_disabled" android:state_enabled="false" />
    <item android:color="@color/elite_lime" android:state_checked="true" />
    <item android:color="@color/elite_text_primary" />
</selector>
