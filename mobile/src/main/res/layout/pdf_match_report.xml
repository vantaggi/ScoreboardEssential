<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/asphalt_dark"
    android:padding="24dp"
    tools:ignore="Overdraw">

    <!-- Header Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/report_pdf_title"
        android:textAppearance="?attr/textAppearanceDisplayLarge"
        android:textColor="@color/stencil_white"
        android:layout_marginBottom="16dp"/>

    <!-- Result Section: una banda per squadra nel suo colore, nome e punteggio in TeamInk.
         Il colore grezzo come testo su #121212 non si leggeva (il blu #0D47A1 fa 2,17:1). -->
    <LinearLayout
        android:id="@+id/pdf_team1_band"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/pdf_team1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/asphalt_black"
            tools:text="TEAM 1"/>

        <TextView
            android:id="@+id/pdf_team1_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceDisplayLarge"
            android:textColor="@color/asphalt_black"
            tools:text="10"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pdf_team2_band"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/pdf_team2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/asphalt_black"
            tools:text="TEAM 2"/>

        <TextView
            android:id="@+id/pdf_team2_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceDisplayLarge"
            android:textColor="@color/asphalt_black"
            tools:text="8"/>
    </LinearLayout>

    <!-- Formations Section -->
    <TextView
        android:id="@+id/pdf_formations_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_formations"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/sidewalk_gray"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:id="@+id/pdf_formations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/pdf_team1_players_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"/>

        <LinearLayout
            android:id="@+id/pdf_team2_players_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"/>
    </LinearLayout>

    <!-- Scorers Section -->
    <TextView
        android:id="@+id/pdf_scorers_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/report_pdf_scorers_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/sidewalk_gray"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:id="@+id/pdf_scorers_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"/>

</LinearLayout>