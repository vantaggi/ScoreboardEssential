<?xml version="1.0" encoding="utf-8"?>
<!--
    La pagina del report PDF (G-8). Esce dal telefono e si stampa, quindi sta su carta chiara: gli
    stessi ruoli del tema scuro nei valori print_* (DESIGN.md, conflitto 14). Un solo compito: il
    risultato. Il resto sono due gruppi tonali con righe sottili. Il colore di squadra e' solo la
    barretta accanto al nome (si mette dal codice); il testo e' sempre text-primary. Numeri e testi
    in Inter con cifre tabulari, pesi 400 e 600, niente maiuscolo, niente ombre.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/print_background"
    android:orientation="vertical"
    android:padding="@dimen/space_24"
    tools:ignore="Overdraw">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_16"
        android:fontFeatureSettings="tnum"
        android:text="@string/report_pdf_title"
        android:textAppearance="?attr/textAppearanceHeadlineLarge"
        android:textColor="@color/print_text_primary"
        android:textFontWeight="600" />

    <!-- Il risultato: un gruppo, una riga per squadra, il punteggio a destra. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_print_group"
        android:divider="@drawable/print_divider"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:showDividers="middle">

        <LinearLayout
            android:id="@+id/pdf_team1_band"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/space_8">

            <TextView
                android:id="@+id/pdf_team1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.App.SectionHeading"
                android:textColor="@color/print_text_primary"
                tools:text="Squadra 1" />

            <TextView
                android:id="@+id/pdf_team1_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Punteggio"
                android:textColor="@color/print_text_primary"
                android:textSize="32sp"
                tools:text="10" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pdf_team2_band"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/space_8">

            <TextView
                android:id="@+id/pdf_team2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.App.SectionHeading"
                android:textColor="@color/print_text_primary"
                tools:text="Squadra 2" />

            <TextView
                android:id="@+id/pdf_team2_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Punteggio"
                android:textColor="@color/print_text_primary"
                android:textSize="32sp"
                tools:text="8" />
        </LinearLayout>
    </LinearLayout>

    <!-- Formazioni: due colonne in un gruppo, ciascuna col nome della squadra e la sua barretta. -->
    <TextView
        android:id="@+id/pdf_formations_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_8"
        android:fontFeatureSettings="tnum"
        android:text="@string/label_formations"
        android:textAppearance="@style/TextAppearance.App.SectionHeading"
        android:textColor="@color/print_text_primary" />

    <LinearLayout
        android:id="@+id/pdf_formations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_print_group"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/space_16">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pdf_team1_players_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/print_text_secondary"
                tools:text="Squadra 1" />

            <LinearLayout
                android:id="@+id/pdf_team1_players_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/print_divider"
                android:orientation="vertical"
                android:showDividers="middle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pdf_team2_players_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/print_text_secondary"
                tools:text="Squadra 2" />

            <LinearLayout
                android:id="@+id/pdf_team2_players_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/print_divider"
                android:orientation="vertical"
                android:showDividers="middle" />
        </LinearLayout>
    </LinearLayout>

    <!-- Marcatori: solo dove si chiede chi ha segnato; il titolo e il gruppo spariscono insieme. -->
    <TextView
        android:id="@+id/pdf_scorers_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_8"
        android:fontFeatureSettings="tnum"
        android:text="@string/report_pdf_scorers_title"
        android:textAppearance="@style/TextAppearance.App.SectionHeading"
        android:textColor="@color/print_text_primary" />

    <LinearLayout
        android:id="@+id/pdf_scorers_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_print_group"
        android:divider="@drawable/print_divider"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_16"
        android:showDividers="middle" />

</LinearLayout>
