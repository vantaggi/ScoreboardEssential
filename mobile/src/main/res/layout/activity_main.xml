<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/asphalt_black" tools:context=".MainActivity" tools:ignore="Overdraw">

    <!--
        Due livelli in un solo file: la schermata di gioco resta in verticale (MainActivity e'
        bloccata nel manifest), quindi non esiste piu' una variante orizzontale.
        Sotto, la colonna di gioco: cio che si usa mentre si gioca, e niente scorre.
        Sopra, il foglio PARTITA: rose, registro, formazioni e azioni, cioe' cio che si consulta.
        Parte nascosto, si apre con il pulsante della barra e si chiude trascinando, con CHIUDI o
        con indietro. Vive in questa Activity e non in una nuova, che creerebbe un secondo
        MainViewModel. Al posto dei FAB, i pulsanti in fondo al foglio.
        Il nero pieno copre di proposito il fondo della finestra: e' il fondo della sola
        schermata di gioco, da qui tools:ignore Overdraw.
    -->
    <include
        layout="@layout/content_scoreboard_live"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        Scrim: fra la colonna di gioco e il foglio. A foglio aperto scurisce la colonna e
        intercetta i tocchi, cosi' un doppio tocco sulla zona + non segna un punto sotto il foglio.
        Nero al 60% (DESIGN.md dice solo che la colonna "resta sotto scurita"); alpha e visibilita'
        li governa MainActivity. Toccarlo chiude il foglio. Fuori da TalkBack: CHIUDI c'e' gia'.
    -->
    <View
        android:id="@+id/match_sheet_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/black"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!--
        Il foglio gestisce da se' gli inset di sistema (in alto, in basso e ai lati) invece di
        riceverli come padding del contenitore: il behavior lo posiziona su parent.getHeight() e
        lo misura togliendo il padding del genitore, quindi con il padding sul contenitore il fondo
        del foglio finiva sotto la barra di navigazione e in alto restava una striscia.
        behavior_shouldRemoveExpandedCorners vale true di default: senza il false qui il taglio
        da 12dp spariva proprio a foglio aperto.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/match_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_skipCollapsed="true"
        app:behavior_paddingTopSystemWindowInsets="true"
        app:behavior_paddingBottomSystemWindowInsets="true"
        app:behavior_paddingLeftSystemWindowInsets="true"
        app:behavior_paddingRightSystemWindowInsets="true"
        app:behavior_shouldRemoveExpandedCorners="false"
        app:backgroundTint="@color/asphalt_dark"
        app:shapeAppearance="@style/ShapeAppearance.App.MatchSheet">

        <include
            layout="@layout/content_scoreboard_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
