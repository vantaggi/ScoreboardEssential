<?xml version="1.0" encoding="utf-8"?>
<!-- La ruota sta in uno scorrevole: a 360dp con il carattere al 200% il dialogo non e' alto abbastanza per ruota, cursore e bottoni. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <!-- Anteprima: il colore che si sta muovendo con il testo che ci andra' sopra. Cresce col carattere. -->
        <TextView
            android:id="@+id/colorPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/space_16"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:maxLines="2"
            android:minWidth="96dp"
            android:minHeight="64dp"
            android:padding="@dimen/space_8"
            android:textSize="16sp"
            android:textFontWeight="600"
            tools:text="12\nROSSI" />

        <com.skydoves.colorpickerview.ColorPickerView
            android:id="@+id/colorPickerView"
            android:layout_width="match_parent"
            android:layout_height="300dp" />

        <com.skydoves.colorpickerview.sliders.BrightnessSlideBar
            android:id="@+id/brightnessSlide"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_touch"
            android:layout_marginTop="@dimen/space_16" />

    </LinearLayout>
</ScrollView>
