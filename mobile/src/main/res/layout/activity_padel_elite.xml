<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".padelelite.PadelEliteActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:title="@string/padel_elite_title"
        app:titleTextColor="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_16">

            <!-- Senza accesso: Google, poi il modulo. Un solo primario, "Accedi". -->
            <LinearLayout
                android:id="@+id/login_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/padel_elite_login_title"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/padel_elite_login_hint"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/text_secondary" />

                <!-- Google prima: e' l'accesso dei piu' nella dashboard. Secondario, perche' il primario della
                     regione resta "Accedi" del modulo; l'icona dice che si apre fuori dall'app (il browser). -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/google_button"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/padel_elite_sign_in_google"
                    app:icon="@drawable/ic_open_in_new"
                    app:iconGravity="textEnd"
                    app:iconSize="@dimen/icon_standard" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/padel_elite_or_email"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/text_secondary" />

                <!-- L'etichetta sta SOPRA il campo e si vede sempre; l'errore sotto il campo. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:labelFor="@+id/email_edit"
                    android:text="@string/padel_elite_email"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/email_layout"
                    style="@style/Widget.App.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:minHeight="@dimen/control_touch" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:labelFor="@+id/password_edit"
                    android:text="@string/padel_elite_password"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/password_layout"
                    style="@style/Widget.App.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    app:endIconMode="password_toggle"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:minHeight="@dimen/control_touch" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Errori che non sono di un campo (rete, troppi tentativi): parola e icona, mai solo il colore. -->
                <TextView
                    android:id="@+id/login_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/text_primary"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_cancel"
                    app:drawableTint="@color/status_error"
                    tools:text="Nessuna connessione. Controlla la rete e riprova."
                    tools:visibility="visible" />

                <!-- Larga quanto la riga: con "Accesso in corso" la larghezza non cambia. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login_button"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/padel_elite_sign_in" />
            </LinearLayout>

            <!--
                Con accesso (revisione dei menu, passo 4): il gruppo per l'invio, poi i giocatori del gruppo
                (prima i collegati, gli altri dietro una ricerca), in fondo Esci con l'account. Aggiorna sta
                nella barra in alto.
            -->
            <LinearLayout
                android:id="@+id/account_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/padel_elite_groups_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/padel_elite_groups_hint"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/text_secondary" />

                <!-- I gruppi sono righe a scelta singola da 48dp dentro un gruppo tonale. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8">

                    <RadioGroup
                        android:id="@+id/group_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_8" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/groups_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/text_secondary"
                    tools:text="Carico i tuoi gruppi" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/groups_retry_button"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/padel_elite_retry"
                    android:visibility="gone" />

                <!--
                    R-1, "Giocatori del gruppo": la rosa della dashboard, riga per riga, e a chi e' collegata
                    nell'app. Un gruppo tonale con righe (non card). Stati: scegli un gruppo, in caricamento,
                    vuota e errore di rete (EmptyStateView), con righe. Nessun primario: e' una scelta.
                -->
                <LinearLayout
                    android:id="@+id/rosa_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_32"
                        android:accessibilityHeading="true"
                        android:text="@string/padel_elite_rosa_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/padel_elite_rosa_hint"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/rosa_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/text_secondary"
                        tools:text="Carico i giocatori del gruppo" />

                    <it.vantaggi.scoreboardessential.ui.EmptyStateView
                        android:id="@+id/rosa_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <!-- Collegati: i giocatori che contano, sempre in vista. Il numero dice quanti sono. -->
                    <TextView
                        android:id="@+id/rosa_linked_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:visibility="gone"
                        tools:text="Collegati · 3" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/rosa_group"
                        style="@style/Widget.App.Group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/rosa_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </com.google.android.material.card.MaterialCardView>

                    <!--
                        Da collegare: i nomi uguali da confermare in cima, poi tutti gli altri; la ricerca
                        stringe la lista. Stati: tutti (campo vuoto), nessun risultato, righe trovate.
                    -->
                    <LinearLayout
                        android:id="@+id/rosa_to_link_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/rosa_to_link_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_16"
                            android:accessibilityHeading="true"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            tools:text="Da collegare · 44" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/rosa_search_layout"
                            style="@style/Widget.App.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:hint="@string/padel_elite_rosa_search"
                            app:endIconMode="clear_text"
                            app:startIconDrawable="@drawable/ic_search">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/rosa_search_edit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionSearch"
                                android:inputType="textPersonName"
                                android:minHeight="@dimen/control_touch" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/rosa_search_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:accessibilityLiveRegion="polite"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            tools:text="Nessun giocatore da collegare con questo nome." />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/rosa_to_link_group"
                            style="@style/Widget.App.Group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/rosa_to_link_list"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Compare solo con nomi uguali da proporre: la proposta si conferma con questo comando. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rosa_same_names_button"
                            style="@style/Widget.App.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Esci non e' l'azione della schermata: testuale, in fondo, senza peso. Sotto, con quale account. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logout_button"
                    style="@style/Widget.App.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_32"
                    android:text="@string/padel_elite_sign_out" />

                <TextView
                    android:id="@+id/account_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    tools:text="Collegato come mattia@example.com" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
