<?xml version="1.0" encoding="utf-8"?>
<!--
    Il foglio PARTITA (G-6): cio' che si consulta, non cio' che si usa mentre si gioca. Quattro gruppi
    tonali (rose, coppie, registro, formazioni) con righe separate da linee rientrate, poi i comandi di
    questa partita e in fondo i posti dell'app. Il colore della squadra e' solo una barretta accanto al
    nome, mai un blocco pieno con il testo sopra. Un solo primario nel foglio, FINE PARTITA. Niente colori
    Street, niente maiuscolo forzato.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scoreboard_details"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingTop="@dimen/space_8">

    <!-- Testa del foglio: titolo e CHIUDI. Chiude anche il trascinamento verso il basso o indietro. -->
    <TextView
        android:id="@+id/match_sheet_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/label_match_sheet"
        android:textAppearance="@style/TextAppearance.App.SectionHeading"
        app:layout_constraintBottom_toBottomOf="@id/match_sheet_close_button"
        app:layout_constraintEnd_toStartOf="@id/match_sheet_close_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/match_sheet_close_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/match_sheet_close_button"
        style="@style/Widget.App.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_close_sheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Avviso persistente dell'orologio: c'e' finche' l'arretrato rifiutato riguarda questa partita.
         Descrive e non prescrive. Fondo status-error-subtle, barretta di errore e testo primario (la
         parola dice lo stato, il colore non e' l'unico segno). Nascosto di norma: a GONE il foglio
         resta identico. -->
    <LinearLayout
        android:id="@+id/watch_notice_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:background="@color/status_error_subtle"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/match_sheet_close_button">

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/status_error" />

        <TextView
            android:id="@+id/watch_notice_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_vertical"
            android:minHeight="@dimen/control_touch"
            android:padding="@dimen/space_12"
            android:text="@string/watch_batch_rejected"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!--
        Serata (padel e tennis): il punto piu' naturale per cominciarla e' qui, dove si compongono le rose e le
        coppie; il dialogo di fine partita la riapre per la partita dopo. Un gruppo con il riassunto e un
        comando secondario (il primario del foglio resta Fine partita). Nascosto negli sport senza coppie.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/serata_card"
        style="@style/Widget.App.Group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/watch_notice_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/serata_sheet_title"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <TextView
                android:id="@+id/serata_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.RowTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/serata_open_button"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/serata_sheet_new"
                app:icon="@drawable/ic_groups"
                app:iconSize="@dimen/icon_standard" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!--
        Diretta (D-2, solo owner e admin del gruppo di Padel Elite, solo padel): un interruttore che si accende
        prima o durante la partita, e sotto lo stato in parole con un'icona (in diretta, non trasmette col motivo,
        spenta col motivo, chiusa). Sta nel foglio e non in gioco: in gioco c'e' un numero per lato, e la
        diretta si prepara dove si compongono le coppie. Nessun bottone primario (il primario del foglio resta
        Fine partita). Nascosto di norma: a GONE il foglio resta identico.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/diretta_card"
        style="@style/Widget.App.Group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/serata_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/diretta_title"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/diretta_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/diretta_switch"
                    android:textAppearance="@style/TextAppearance.App.RowTitle" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/diretta_switch"
                    style="@style/Widget.App.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:contentDescription="@string/diretta_switch" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/diretta_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/diretta_status_icon"
                    android:layout_width="@dimen/icon_standard"
                    android:layout_height="@dimen/icon_standard"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sensors" />

                <TextView
                    android:id="@+id/diretta_status_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Rose -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rosters_card"
        style="@style/Widget.App.Group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/diretta_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:text="@string/label_team_rosters"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/team1_roster_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_8"
                        android:text="@string/label_team_1"
                        android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/team1_roster_recyclerview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_team1_player_button"
                        style="@style/Widget.App.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/label_add_player" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/team2_roster_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_8"
                        android:text="@string/label_team_2"
                        android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/team2_roster_recyclerview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_team2_player_button"
                        style="@style/Widget.App.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/label_add_player" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Coppie (padel e tennis in doppio): due posti numerati per lato, nell'ordine delle rose. Il primo serve per primo. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pairs_card"
        style="@style/Widget.App.Group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rosters_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:text="@string/label_pairs"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/team1_pair_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_8"
                        android:text="@string/label_team_1"
                        android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <LinearLayout
                        android:id="@+id/team1_slot1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/space_48"
                        android:orientation="horizontal"
                        android:screenReaderFocusable="true">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/pair_place_1"
                            android:textAppearance="@style/TextAppearance.App.Caption" />

                        <TextView
                            android:id="@+id/team1_slot1_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:importantForAccessibility="no"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.RowTitle" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/team1_slot2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/space_48"
                        android:orientation="horizontal"
                        android:screenReaderFocusable="true">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/pair_place_2"
                            android:textAppearance="@style/TextAppearance.App.Caption" />

                        <TextView
                            android:id="@+id/team1_slot2_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:importantForAccessibility="no"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.RowTitle" />
                    </LinearLayout>

                    <!-- Scambio da 48dp: inverte i due, e quindi chi serve per primo. Dopo il primo punto si spegne col lucchetto. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/team1_swap_button"
                        style="@style/Widget.App.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:paddingHorizontal="@dimen/space_8"
                        android:text="@string/label_pair_swap"
                        app:icon="@drawable/ic_swap_horiz"
                        app:iconSize="@dimen/icon_standard" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/team2_pair_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_8"
                        android:text="@string/label_team_2"
                        android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <LinearLayout
                        android:id="@+id/team2_slot1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/space_48"
                        android:orientation="horizontal"
                        android:screenReaderFocusable="true">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/pair_place_1"
                            android:textAppearance="@style/TextAppearance.App.Caption" />

                        <TextView
                            android:id="@+id/team2_slot1_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:importantForAccessibility="no"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.RowTitle" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/team2_slot2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/space_48"
                        android:orientation="horizontal"
                        android:screenReaderFocusable="true">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/pair_place_2"
                            android:textAppearance="@style/TextAppearance.App.Caption" />

                        <TextView
                            android:id="@+id/team2_slot2_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:importantForAccessibility="no"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.RowTitle" />
                    </LinearLayout>

                    <!-- Scambio da 48dp: inverte i due, e quindi chi serve per primo. Dopo il primo punto si spegne col lucchetto. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/team2_swap_button"
                        style="@style/Widget.App.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:paddingHorizontal="@dimen/space_8"
                        android:text="@string/label_pair_swap"
                        app:icon="@drawable/ic_swap_horiz"
                        app:iconSize="@dimen/icon_standard" />
                </LinearLayout>
            </LinearLayout>

            <!-- A partita cominciata lo scambio si spegne: chi serve si corregge da qui, come un errore da sistemare. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/serve_correct_button"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/serve_correct_button"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Registro -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/match_log_card"
        style="@style/Widget.App.Group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pairs_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:text="@string/label_match_log"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/match_log_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Formazioni: il nome di ogni squadra ha la sua barretta di colore; nessun blocco pieno. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/formations_card"
        style="@style/Widget.App.Group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/match_log_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:text="@string/label_formations"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <!-- Le due formazioni affiancate; col testo grande una sotto l'altra (disponiLeFormazioni). -->
            <LinearLayout
                android:id="@+id/formations_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/team1_formation_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.App.RowTitle"
                        tools:text="Team 1: 4-4-2" />

                    <it.vantaggi.scoreboardessential.views.FormationView
                        android:id="@+id/team1_formation_view"
                        android:layout_width="match_parent"
                        android:layout_height="200dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/team2_formation_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.App.RowTitle"
                        tools:text="Team 2: 4-3-3" />

                    <it.vantaggi.scoreboardessential.views.FormationView
                        android:id="@+id/team2_formation_view"
                        android:layout_width="match_parent"
                        android:layout_height="200dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!--
        Questa partita, poi l'app (revisione dei menu, passo 3). Prima i comandi su questa partita: Condividi
        e, solo col cronometro, Azzera tempo (applyCapabilities lo spegne negli altri sport), secondari della
        stessa misura; sotto FINE PARTITA, l'unico primario del foglio, a tutta larghezza. Poi i posti
        dell'app come righe di un gruppo con la freccia: si leggono come "vai a", non come sei bottoni uguali.
    -->
    <LinearLayout
        android:id="@+id/match_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:layout_marginBottom="@dimen/space_16"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/formations_card"
        app:layout_constraintVertical_bias="0">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:accessibilityHeading="true"
            android:text="@string/label_sheet_this_match"
            android:textAppearance="@style/TextAppearance.App.Caption" />

        <!-- I due comandi hanno la stessa altezza anche se uno va a capo (200%): match_parent li alza al piu' alto. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/share_match_button"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:maxLines="2"
                android:paddingHorizontal="@dimen/space_8"
                android:text="@string/share_match_report" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_reset_timer_button"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:maxLines="2"
                android:paddingHorizontal="@dimen/space_8"
                android:text="@string/label_reset_match_time" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset_scores_button"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/label_end_match" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:layout_marginBottom="@dimen/space_8"
            android:accessibilityHeading="true"
            android:text="@string/label_sheet_app"
            android:textAppearance="@style/TextAppearance.App.Caption" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/app_places_card"
            style="@style/Widget.App.Group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/match_history_button"
                    style="@style/Widget.App.Pressable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/bg_focus_ring"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/control_touch"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="@dimen/space_8">

                    <ImageView
                        android:layout_width="@dimen/icon_standard"
                        android:layout_height="@dimen/icon_standard"
                        android:layout_marginEnd="@dimen/space_12"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_history"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_match_history"
                        android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <ImageView
                        android:layout_width="@dimen/icon_standard"
                        android:layout_height="@dimen/icon_standard"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <View
                    style="@style/Widget.App.RowDivider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/border_width"
                    android:layout_marginStart="@dimen/space_48" />

                <LinearLayout
                    android:id="@+id/statistics_button"
                    style="@style/Widget.App.Pressable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/bg_focus_ring"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/control_touch"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="@dimen/space_8">

                    <ImageView
                        android:layout_width="@dimen/icon_standard"
                        android:layout_height="@dimen/icon_standard"
                        android:layout_marginEnd="@dimen/space_12"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bar_chart"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_statistics"
                        android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <ImageView
                        android:layout_width="@dimen/icon_standard"
                        android:layout_height="@dimen/icon_standard"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <View
                    style="@style/Widget.App.RowDivider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/border_width"
                    android:layout_marginStart="@dimen/space_48" />

                <LinearLayout
                    android:id="@+id/players_button"
                    style="@style/Widget.App.Pressable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/bg_focus_ring"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/control_touch"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="@dimen/space_8">

                    <ImageView
                        android:layout_width="@dimen/icon_standard"
                        android:layout_height="@dimen/icon_standard"
                        android:layout_marginEnd="@dimen/space_12"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_person"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_players"
                        android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <ImageView
                        android:layout_width="@dimen/icon_standard"
                        android:layout_height="@dimen/icon_standard"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <View
                    style="@style/Widget.App.RowDivider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/border_width"
                    android:layout_marginStart="@dimen/space_48" />

                <LinearLayout
                    android:id="@+id/sheet_settings_button"
                    style="@style/Widget.App.Pressable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/bg_focus_ring"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/control_touch"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="@dimen/space_8">

                    <ImageView
                        android:layout_width="@dimen/icon_standard"
                        android:layout_height="@dimen/icon_standard"
                        android:layout_marginEnd="@dimen/space_12"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_settings"
                        android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <ImageView
                        android:layout_width="@dimen/icon_standard"
                        android:layout_height="@dimen/icon_standard"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
