<?xml version="1.0" encoding="utf-8"?>
<!--
    Il foglio PARTITA (G-6): cio' che si consulta, non cio' che si usa mentre si gioca. Quattro gruppi
    tonali (rose, coppie, registro, formazioni) con righe separate da linee rientrate, e le azioni. Il
    colore della squadra e' solo una barretta accanto al nome, mai un blocco pieno con il testo sopra. Un
    solo primario nel foglio, FINE PARTITA; gli altri comandi sono secondari e in fila. Niente colori
    Street, niente maiuscolo forzato.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scoreboard_details"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingTop="@dimen/space_8">

    <!-- Testa del foglio: titolo e CHIUDI. Chiude anche il trascinamento verso il basso o indietro. -->
    <TextView
        android:id="@+id/match_sheet_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/label_match_sheet"
        android:textAppearance="@style/TextAppearance.App.SectionHeading"
        app:layout_constraintBottom_toBottomOf="@id/match_sheet_close_button"
        app:layout_constraintEnd_toStartOf="@id/match_sheet_close_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/match_sheet_close_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/match_sheet_close_button"
        style="@style/Widget.App.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_close_sheet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Avviso persistente dell'orologio: c'e' finche' l'arretrato rifiutato riguarda questa partita.
         Descrive e non prescrive. Fondo status-error-subtle, barretta di errore e testo primario (la
         parola dice lo stato, il colore non e' l'unico segno). Nascosto di norma: a GONE il foglio
         resta identico. -->
    <LinearLayout
        android:id="@+id/watch_notice_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:background="@color/elite_error_subtle"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/match_sheet_close_button">

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/elite_error" />

        <TextView
            android:id="@+id/watch_notice_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:gravity="center_vertical"
            android:minHeight="@dimen/control_touch"
            android:padding="@dimen/space_12"
            android:text="@string/watch_batch_rejected"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:textColor="@color/elite_text_primary" />
    </LinearLayout>

    <!-- Rose -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rosters_card"
        style="@style/Widget.App.Group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/watch_notice_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:text="@string/label_team_rosters"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/team1_roster_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_8"
                        android:text="@string/label_team_1"
                        android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/team1_roster_recyclerview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_team1_player_button"
                        style="@style/Widget.App.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/label_add_player" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/team2_roster_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_8"
                        android:text="@string/label_team_2"
                        android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/team2_roster_recyclerview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_team2_player_button"
                        style="@style/Widget.App.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/label_add_player" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Coppie (padel e tennis in doppio): due posti numerati per lato, nell'ordine delle rose. Il primo serve per primo. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pairs_card"
        style="@style/Widget.App.Group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rosters_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:text="@string/label_pairs"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/team1_pair_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_8"
                        android:text="@string/label_team_1"
                        android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <LinearLayout
                        android:id="@+id/team1_slot1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/space_48"
                        android:orientation="horizontal"
                        android:screenReaderFocusable="true">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/pair_place_1"
                            android:textAppearance="@style/TextAppearance.App.Caption" />

                        <TextView
                            android:id="@+id/team1_slot1_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:importantForAccessibility="no"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.RowTitle" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/team1_slot2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/space_48"
                        android:orientation="horizontal"
                        android:screenReaderFocusable="true">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/pair_place_2"
                            android:textAppearance="@style/TextAppearance.App.Caption" />

                        <TextView
                            android:id="@+id/team1_slot2_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:importantForAccessibility="no"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.RowTitle" />
                    </LinearLayout>

                    <!-- Scambio da 48dp: inverte i due, e quindi chi serve per primo. Dopo il primo punto si spegne col lucchetto. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/team1_swap_button"
                        style="@style/Widget.App.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/label_pair_swap"
                        app:icon="@drawable/ic_swap_horiz"
                        app:iconSize="@dimen/icon_standard" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/team2_pair_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_8"
                        android:text="@string/label_team_2"
                        android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <LinearLayout
                        android:id="@+id/team2_slot1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/space_48"
                        android:orientation="horizontal"
                        android:screenReaderFocusable="true">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/pair_place_1"
                            android:textAppearance="@style/TextAppearance.App.Caption" />

                        <TextView
                            android:id="@+id/team2_slot1_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:importantForAccessibility="no"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.RowTitle" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/team2_slot2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/space_48"
                        android:orientation="horizontal"
                        android:screenReaderFocusable="true">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="@string/pair_place_2"
                            android:textAppearance="@style/TextAppearance.App.Caption" />

                        <TextView
                            android:id="@+id/team2_slot2_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:importantForAccessibility="no"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.RowTitle" />
                    </LinearLayout>

                    <!-- Scambio da 48dp: inverte i due, e quindi chi serve per primo. Dopo il primo punto si spegne col lucchetto. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/team2_swap_button"
                        style="@style/Widget.App.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/label_pair_swap"
                        app:icon="@drawable/ic_swap_horiz"
                        app:iconSize="@dimen/icon_standard" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Registro -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/match_log_card"
        style="@style/Widget.App.Group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pairs_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:text="@string/label_match_log"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/match_log_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Formazioni: il nome di ogni squadra ha la sua barretta di colore; nessun blocco pieno. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/formations_card"
        style="@style/Widget.App.Group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/match_log_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:text="@string/label_formations"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/team1_formation_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.App.RowTitle"
                        tools:text="Team 1: 4-4-2" />

                    <it.vantaggi.scoreboardessential.views.FormationView
                        android:id="@+id/team1_formation_view"
                        android:layout_width="match_parent"
                        android:layout_height="200dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/team2_formation_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.App.RowTitle"
                        tools:text="Team 2: 4-3-3" />

                    <it.vantaggi.scoreboardessential.views.FormationView
                        android:id="@+id/team2_formation_view"
                        android:layout_width="match_parent"
                        android:layout_height="200dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!--
        Azioni. Un solo primario nel foglio, FINE PARTITA, a tutta larghezza: e' l'unico comando che
        chiude qualcosa e non va confuso con gli altri. Sotto, i secondari in file da tre con la stessa
        misura (STORICO, CONDIVIDI, STATISTICHE; GIOCATORI, IMPOSTAZIONI e, solo col cronometro,
        AZZERA TEMPO: applyCapabilities lo spegne negli altri sport e la riga si divide in due).
    -->
    <LinearLayout
        android:id="@+id/match_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:layout_marginBottom="@dimen/space_16"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/formations_card"
        app:layout_constraintVertical_bias="0">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset_scores_button"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_end_match" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/match_history_button"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:paddingHorizontal="@dimen/space_8"
                android:text="@string/label_match_history" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/share_match_button"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_8"
                android:layout_weight="1"
                android:maxLines="2"
                android:paddingHorizontal="@dimen/space_8"
                android:text="@string/share_match_report" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/statistics_button"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:paddingHorizontal="@dimen/space_8"
                android:text="@string/label_statistics" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/players_button"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:paddingHorizontal="@dimen/space_8"
                android:text="@string/label_players" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_settings_button"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:maxLines="2"
                android:paddingHorizontal="@dimen/space_8"
                android:text="@string/label_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_reset_timer_button"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:maxLines="2"
                android:paddingHorizontal="@dimen/space_8"
                android:text="@string/label_reset_match_time" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
