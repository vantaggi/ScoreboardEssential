<?xml version="1.0" encoding="utf-8"?>
<!-- Cio' che si consulta, non cio' che si usa mentre si gioca: rose, registro, formazioni, azioni. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scoreboard_details"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp">

        <!-- Testa del foglio: titolo e CHIUDI. Chiude anche il trascinamento verso il basso o indietro. -->
        <TextView android:id="@+id/match_sheet_title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/label_match_sheet" android:textColor="@color/stencil_white" android:textSize="20sp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:letterSpacing="0.06" android:maxLines="1" android:ellipsize="end" android:accessibilityHeading="true" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/match_sheet_close_button" app:layout_constraintTop_toTopOf="@id/match_sheet_close_button" app:layout_constraintBottom_toBottomOf="@id/match_sheet_close_button"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/match_sheet_close_button" style="@style/Widget.App.Button.TextButton.Street" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_close_sheet" android:textColor="@color/stencil_white" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"/>

        <!-- Avviso persistente dell'orologio: c'e' finche' l'arretrato rifiutato riguarda questa partita.
             Descrive e non prescrive. Nascosto di norma: a GONE il foglio resta identico. -->
        <LinearLayout android:id="@+id/watch_notice_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@color/concrete_gray" android:orientation="horizontal" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/match_sheet_close_button" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

            <View android:layout_width="4dp" android:layout_height="match_parent" android:background="@color/error_red"/>

            <TextView android:id="@+id/watch_notice_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:gravity="center_vertical" android:padding="12dp" android:text="@string/watch_batch_rejected" android:textColor="@color/stencil_white" android:textSize="14sp" android:accessibilityLiveRegion="polite"/>
        </LinearLayout>

        <!-- Team Rosters Section (Scrollable) -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/rosters_card" style="?attr/materialCardViewElevatedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardBackgroundColor="@android:color/transparent" app:cardElevation="4dp" app:shapeAppearance="@style/ShapeAppearance.App.StreetCard" app:layout_constraintTop_toBottomOf="@id/watch_notice_card" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_concrete_card" android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_team_rosters" android:textAppearance="?attr/textAppearanceHeadlineMedium" android:textColor="@color/sidewalk_gray" android:textSize="14sp" android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

                    <!-- Team 1 Roster -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/team1_roster_label" android:text="@string/label_team_1" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:layout_marginBottom="8dp"/>

                        <androidx.recyclerview.widget.RecyclerView android:id="@+id/team1_roster_recyclerview" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>

                        <com.google.android.material.button.MaterialButton android:id="@+id/add_team1_player_button" style="@style/Widget.App.Button.TextButton.Street" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_add_player" android:layout_marginTop="8dp"/>
                    </LinearLayout>

                    <!-- Team 2 Roster -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/team2_roster_label" android:text="@string/label_team_2" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:layout_marginBottom="8dp"/>

                        <androidx.recyclerview.widget.RecyclerView android:id="@+id/team2_roster_recyclerview" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>

                        <com.google.android.material.button.MaterialButton android:id="@+id/add_team2_player_button" style="@style/Widget.App.Button.TextButton.Street" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_add_player" android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Coppie (padel e tennis in doppio): due posti numerati per lato, nell'ordine delle rose. Il primo serve per primo. -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/pairs_card" style="?attr/materialCardViewElevatedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone" app:cardBackgroundColor="@android:color/transparent" app:cardElevation="4dp" app:shapeAppearance="@style/ShapeAppearance.App.StreetCard" app:layout_constraintTop_toBottomOf="@id/rosters_card" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_concrete_card" android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_pairs" android:textAppearance="?attr/textAppearanceHeadlineMedium" android:textColor="@color/sidewalk_gray" android:textSize="14sp" android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">

                        <TextView android:id="@+id/team1_pair_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_team_1" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:layout_marginBottom="8dp"/>

                        <LinearLayout android:id="@+id/team1_slot1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:orientation="horizontal">

                            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="1" android:textColor="@color/sidewalk_gray" android:textSize="18sp" android:textStyle="bold" android:importantForAccessibility="no"/>

                            <TextView android:id="@+id/team1_slot1_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/stencil_white" android:textSize="16sp" android:maxLines="1" android:ellipsize="end"/>
                        </LinearLayout>

                        <LinearLayout android:id="@+id/team1_slot2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:orientation="horizontal">

                            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="2" android:textColor="@color/sidewalk_gray" android:textSize="18sp" android:textStyle="bold" android:importantForAccessibility="no"/>

                            <TextView android:id="@+id/team1_slot2_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/stencil_white" android:textSize="16sp" android:maxLines="1" android:ellipsize="end"/>
                        </LinearLayout>

                        <!-- Scambio da 48dp: inverte i due, e quindi chi serve per primo. Dopo il primo punto si spegne col lucchetto. -->
                        <com.google.android.material.button.MaterialButton android:id="@+id/team1_swap_button" style="@style/Widget.App.Button.OutlinedButton.Street" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/label_pair_swap" app:icon="@drawable/ic_swap" app:iconTint="@color/stencil_white"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">

                        <TextView android:id="@+id/team2_pair_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_team_2" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:layout_marginBottom="8dp"/>

                        <LinearLayout android:id="@+id/team2_slot1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:orientation="horizontal">

                            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="1" android:textColor="@color/sidewalk_gray" android:textSize="18sp" android:textStyle="bold" android:importantForAccessibility="no"/>

                            <TextView android:id="@+id/team2_slot1_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/stencil_white" android:textSize="16sp" android:maxLines="1" android:ellipsize="end"/>
                        </LinearLayout>

                        <LinearLayout android:id="@+id/team2_slot2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:orientation="horizontal">

                            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="2" android:textColor="@color/sidewalk_gray" android:textSize="18sp" android:textStyle="bold" android:importantForAccessibility="no"/>

                            <TextView android:id="@+id/team2_slot2_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/stencil_white" android:textSize="16sp" android:maxLines="1" android:ellipsize="end"/>
                        </LinearLayout>

                        <!-- Scambio da 48dp: inverte i due, e quindi chi serve per primo. Dopo il primo punto si spegne col lucchetto. -->
                        <com.google.android.material.button.MaterialButton android:id="@+id/team2_swap_button" style="@style/Widget.App.Button.OutlinedButton.Street" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/label_pair_swap" app:icon="@drawable/ic_swap" app:iconTint="@color/stencil_white"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Match Log Section -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/match_log_card" style="?attr/materialCardViewElevatedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@android:color/transparent" app:cardElevation="4dp" app:shapeAppearance="@style/ShapeAppearance.App.StreetCard" app:layout_constraintTop_toBottomOf="@id/pairs_card" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_concrete_card" android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_match_log" android:textAppearance="?attr/textAppearanceHeadlineMedium" android:textColor="@color/sidewalk_gray" android:textSize="14sp" android:layout_marginBottom="12dp"/>

                <androidx.recyclerview.widget.RecyclerView android:id="@+id/match_log_recyclerview" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/formations_card" style="?attr/materialCardViewElevatedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@android:color/transparent" app:cardElevation="4dp" app:shapeAppearance="@style/ShapeAppearance.App.StreetCard" app:layout_constraintTop_toBottomOf="@id/match_log_card" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_concrete_card" android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_formations" android:textAppearance="?attr/textAppearanceHeadlineMedium" android:textColor="@color/sidewalk_gray" android:textSize="14sp" android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">

                        <TextView android:id="@+id/team1_formation_label" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="Team 1 (4-4-2)" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:layout_marginBottom="8dp"/>

                        <it.vantaggi.scoreboardessential.views.FormationView android:id="@+id/team1_formation_view" android:layout_width="match_parent" android:layout_height="200dp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">

                        <TextView android:id="@+id/team2_formation_label" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:text="Team 2 (4-3-3)" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:layout_marginBottom="8dp"/>

                        <it.vantaggi.scoreboardessential.views.FormationView android:id="@+id/team2_formation_view" android:layout_width="match_parent" android:layout_height="200dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
            Azioni su righe da tre, tutte alte almeno 48dp. Un solo pulsante pieno, fine partita:
            e' l'unico che chiude qualcosa, e non va confuso con gli altri. La seconda riga prende
            il posto dei due FAB, che coprivano questa stessa riga. La terza c'e' solo con il
            cronometro: applyCapabilities la spegne negli sport senza tempo.
        -->
        <LinearLayout android:id="@+id/match_actions" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp" android:layout_marginBottom="16dp" app:layout_constraintVertical_bias="0" app:layout_constraintTop_toBottomOf="@id/formations_card" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton android:id="@+id/match_history_button" style="@style/Widget.App.Button.OutlinedButton.Street" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingHorizontal="8dp" android:maxLines="2" android:text="@string/label_match_history"/>

                <com.google.android.material.button.MaterialButton android:id="@+id/reset_scores_button" style="@style/Widget.App.Button.Street" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="8dp" android:paddingHorizontal="8dp" android:maxLines="2" android:text="@string/label_end_match"/>

                <com.google.android.material.button.MaterialButton android:id="@+id/share_match_button" style="@style/Widget.App.Button.OutlinedButton.Street" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingHorizontal="8dp" android:maxLines="2" android:text="@string/share_match_report"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton android:id="@+id/statistics_button" style="@style/Widget.App.Button.OutlinedButton.Street" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingHorizontal="8dp" android:maxLines="2" android:text="@string/label_statistics"/>

                <com.google.android.material.button.MaterialButton android:id="@+id/players_button" style="@style/Widget.App.Button.OutlinedButton.Street" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="8dp" android:paddingHorizontal="8dp" android:maxLines="2" android:text="@string/label_players"/>

                <com.google.android.material.button.MaterialButton android:id="@+id/sheet_settings_button" style="@style/Widget.App.Button.OutlinedButton.Street" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingHorizontal="8dp" android:maxLines="2" android:text="@string/label_settings"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/sheet_reset_timer_button" style="@style/Widget.App.Button.OutlinedButton.Street" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/label_reset_match_time"/>
        </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
