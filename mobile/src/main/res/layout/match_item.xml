<com.google.android.material.card.MaterialCardView style="@style/Widget.App.Group" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Sport, data e durata in una riga: un 6-4 di padel e un 2-1 di calcio non si confondono. -->
        <TextView
            android:id="@+id/timestamp_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/inter"
            android:letterSpacing="0.12"
            android:textColor="@color/sidewalk_gray"
            android:textSize="12sp"
            android:textFontWeight="600"
            tools:text="PADEL · 12/09 18:30 · 47 MIN" />

        <!-- Una riga per squadra: etichetta nel colore con cui si e' giocato, risultato a destra.
             Chi ha vinto si legge senza il colore: #E0E0E0 contro #9E9E9E. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/team1_name_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textAllCaps="true"
                    android:textSize="16sp"
                    android:textFontWeight="600"
                    tools:background="@color/team_spray_yellow"
                    tools:text="Team Alpha" />
            </FrameLayout>

            <TextView
                android:id="@+id/team1_score_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Punteggio"
                android:textColor="@color/stencil_white"
                android:textSize="32sp"
                tools:text="10" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/team2_name_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textAllCaps="true"
                    android:textSize="16sp"
                    android:textFontWeight="600"
                    tools:background="@color/team_electric_green"
                    tools:text="Team Beta" />
            </FrameLayout>

            <TextView
                android:id="@+id/team2_score_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Punteggio"
                android:textColor="@color/sidewalk_gray"
                android:textSize="32sp"
                tools:text="8" />
        </LinearLayout>

        <!-- I set per il tennis, la regola per il padel: c'e' solo dove dice qualcosa. -->
        <TextView
            android:id="@+id/sets_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter"
            android:fontFeatureSettings="tnum"
            android:textFontWeight="600"
            android:textColor="@color/sidewalk_gray"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="6-4 · 3-6 · 7-6 (7-4)"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/players_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/sidewalk_gray"
            android:fontFamily="@font/inter"
            tools:text="Players: John, Doe, Jane, Smith" />

        <!-- Esporta sta accanto a Elimina: i comandi di una partita dello storico stanno sulla sua card. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- La Cronaca si apre da qui, come l'export: e' un comando di questa partita. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/chronicle_match_button"
                style="@style/Widget.App.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chronicle_open"
                android:visibility="gone"
                app:icon="@drawable/ic_stats"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/export_match_button"
                style="@style/Widget.App.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_match"
                android:visibility="gone"
                app:icon="@drawable/ic_share"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/delete_match_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete_match"
                app:tint="@color/error_red"
                app:srcCompat="@drawable/ic_delete" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
