<?xml version="1.0" encoding="utf-8"?>
<!--
    Una riga dei giocatori (G-4, passo 6b della revisione dei menu): il nome e sotto il valore che
    conta, le partite giocate (e i gol solo negli sport che li contano); i ruoli solo nel calcio. Si
    tocca per modificare, e la freccia lo dice: prima c'era un'icona a barre muta, uguale su ogni riga.
    Sta dentro un gruppo, non e' una card.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_card"
    style="@style/Widget.App.Pressable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_focus_ring"
    android:minHeight="56dp"
    android:paddingStart="@dimen/space_16"
    android:paddingEnd="@dimen/space_12"
    android:paddingVertical="@dimen/space_8">

    <LinearLayout
        android:id="@+id/info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/player_chevron"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/player_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.RowTitle"
            tools:text="Johnathan Doe" />

        <!-- «3 partite», nel calcio «3 partite · 5 gol». -->
        <TextView
            android:id="@+id/player_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Caption"
            tools:text="3 partite · 5 gol" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/player_roles_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            app:chipSpacingHorizontal="@dimen/space_4"
            app:chipSpacingVertical="0dp"
            app:selectionRequired="false"
            app:singleLine="true">
            <!-- I chip dei ruoli si aggiungono da codice, solo nel calcio -->
        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>

    <!-- Decorativa: la riga intera e' il comando, e TalkBack la legge come tale. -->
    <ImageView
        android:id="@+id/player_chevron"
        android:layout_width="@dimen/icon_standard"
        android:layout_height="@dimen/icon_standard"
        android:layout_marginStart="@dimen/space_8"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/elite_text_secondary" />

</androidx.constraintlayout.widget.ConstraintLayout>
