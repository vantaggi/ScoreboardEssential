<?xml version="1.0" encoding="utf-8"?>
<!--
    Una riga dei giocatori (G-4): il nome e il ruolo; si tocca per modificare. L'unico comando in riga e'
    il dettaglio (presenze, gol, ruoli, azzera): la modifica e' la riga stessa, quindi non ha un secondo
    bottone. Sta dentro un gruppo, non e' una card.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_card"
    style="@style/Widget.App.Pressable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/bg_focus_ring"
    android:minHeight="56dp"
    android:paddingStart="@dimen/space_16"
    android:paddingEnd="@dimen/space_4"
    android:paddingVertical="@dimen/space_8">

    <LinearLayout
        android:id="@+id/info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/stats_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/player_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.RowTitle"
            tools:text="Johnathan Doe" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/player_roles_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            app:chipSpacingHorizontal="@dimen/space_4"
            app:chipSpacingVertical="0dp"
            app:selectionRequired="false"
            app:singleLine="true">
            <!-- I chip dei ruoli si aggiungono da codice -->
        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>

    <ImageButton
        android:id="@+id/stats_button"
        style="@style/Widget.App.Pressable"
        android:layout_width="@dimen/control_touch"
        android:layout_height="@dimen/control_touch"
        android:background="@android:color/transparent"
        android:contentDescription="@string/cd_player_stats"
        android:foreground="@drawable/bg_focus_ring"
        android:src="@drawable/ic_bar_chart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/elite_text_secondary" />

</androidx.constraintlayout.widget.ConstraintLayout>
