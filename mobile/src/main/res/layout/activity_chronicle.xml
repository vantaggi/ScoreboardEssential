<?xml version="1.0" encoding="utf-8"?>
<!--
    La Cronaca (G-5). Il compito: capire com'e' andata la partita. Il valore: il tabellone dei set, in
    cima. Sei gruppi tonali nell'ordine della dashboard, ciascuno col suo stato vuoto; righe e linee
    rientrate dentro i gruppi, nessuna card e nessuna ombra. I colori sono solo ruoli elite_*.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chronicle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elite_background"
    android:orientation="vertical"
    tools:context=".ui.chronicle.ChronicleActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.App.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:subtitleTextColor="@color/elite_text_secondary"
        app:title="@string/chronicle_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_16">

            <!-- Partita o registro che non si leggono: dice cosa manca, perche' e cosa fare. -->
            <it.vantaggi.scoreboardessential.ui.EmptyStateView
                android:id="@+id/chronicle_unavailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:emptyReason="@string/chronicle_unavailable_reason"
                app:emptyTitle="@string/chronicle_unavailable" />

            <!-- Visibili solo dopo il caricamento: prima non c'e' niente di onesto da mostrare. -->
            <LinearLayout
                android:id="@+id/chronicle_sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/section_scoreboard"
                    layout="@layout/chronicle_section" />

                <include
                    android:id="@+id/section_momentum"
                    layout="@layout/chronicle_section" />

                <include
                    android:id="@+id/section_games"
                    layout="@layout/chronicle_section" />

                <include
                    android:id="@+id/section_serve"
                    layout="@layout/chronicle_section" />

                <include
                    android:id="@+id/section_times"
                    layout="@layout/chronicle_section" />

                <include
                    android:id="@+id/section_moments"
                    layout="@layout/chronicle_section" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
