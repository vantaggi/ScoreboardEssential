<?xml version="1.0" encoding="utf-8"?>
<!--
    Statistiche (G-4). Il compito: vedere chi ha segnato di piu'. Il valore: i gol. Tre schede (Generale,
    Attacco, Difesa) con un solo indicatore lime; la classifica e' un gruppo tonale con una riga per
    giocatore (nome e gol), separate da linee sottili rientrate al testo. Rango e presenze non sono in
    riga: il rango e' l'ordine, le presenze stanno nel dettaglio del giocatore (Gestisci giocatori).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/elite_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.App.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        style="@style/Widget.App.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stats_group"
        style="@style/Widget.App.Group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/space_16"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintVertical_bias="0">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_player_stat" />
    </com.google.android.material.card.MaterialCardView>

    <it.vantaggi.scoreboardessential.ui.EmptyStateView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:emptyAction="@string/empty_action_back_to_match"
        app:emptyIcon="@drawable/ic_bar_chart"
        app:emptyReason="@string/stats_empty_hint"
        app:emptyTitle="@string/stats_empty_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>
