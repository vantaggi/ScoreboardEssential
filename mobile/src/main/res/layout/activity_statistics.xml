<?xml version="1.0" encoding="utf-8"?>
<!--
    Statistiche (G-4, revisione dei menu passo 6). In cima si sceglie lo sport (parte da quello in uso) e
    sotto la schermata lo segue. Nel calcio il compito e' vedere chi ha segnato di piu': tre schede
    (Generale, Attacco, Difesa) con un solo indicatore lime e una riga per giocatore (nome e gol). Nel
    padel e nel tennis non ci sono gol: niente schede, una riga di titolo ("Partite vinte") e la
    classifica delle partite vinte su quelle giocate. In tutti e due i casi un gruppo tonale con righe
    separate da linee sottili rientrate.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_canvas">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.App.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Lo sport di cui si guardano le statistiche: una scelta sola, parte da quello in uso. -->
    <HorizontalScrollView
        android:id="@+id/sport_filter_scrollview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sport_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />

    </HorizontalScrollView>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        style="@style/Widget.App.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabGravity="fill"
        app:tabMode="auto"
        app:layout_constraintTop_toBottomOf="@id/sport_filter_scrollview" />

    <!-- Solo negli sport senza marcatori, al posto delle schede. -->
    <TextView
        android:id="@+id/stats_heading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginTop="@dimen/space_16"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        tools:text="Padel · partite vinte" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stats_group"
        style="@style/Widget.App.Group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/space_16"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintTop_toBottomOf="@id/stats_heading"
        app:layout_constraintVertical_bias="0">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_player_stat" />
    </com.google.android.material.card.MaterialCardView>

    <it.vantaggi.scoreboardessential.ui.EmptyStateView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:emptyAction="@string/empty_action_back_to_match"
        app:emptyIcon="@drawable/ic_bar_chart"
        app:emptyReason="@string/stats_empty_hint"
        app:emptyTitle="@string/stats_empty_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>
