<?xml version="1.0" encoding="utf-8"?>
<!--
    Gestisci giocatori (G-4, passo 6b). Il compito: tenere l'elenco di chi gioca. Il valore: il nome
    e le partite giocate. In cima la ricerca, un campo vero e sempre visibile (come in Padel Elite);
    sotto i filtri per ruolo, solo nel calcio. L'elenco e' un gruppo tonale, una riga per giocatore. Il primario e' uno solo per volta: il tasto
    "aggiungi" (lime) quando l'elenco ha delle righe, il bottone dello stato vuoto quando non ne ha.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_canvas"
    android:fitsSystemWindows="true"
    tools:context=".PlayersManagementActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.App.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Dark" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/players_search_layout"
            style="@style/Widget.App.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_16"
            android:hint="@string/search_players_hint"
            app:endIconMode="clear_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/players_search_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="textPersonName"
                android:minHeight="@dimen/control_touch" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- I ruoli sono del calcio: negli altri sport la riga non c'e' (PlayersManagementActivity). -->
        <HorizontalScrollView
            android:id="@+id/roles_filter_scrollview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:scrollbars="none"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/players_search_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/roles_filter_chip_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                app:singleLine="true"
                app:singleSelection="true"/>

        </HorizontalScrollView>

        <!-- Il gruppo e' alto quanto le righe, non oltre lo schermo. Sotto resta il posto del tasto "aggiungi". -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/players_group"
            style="@style/Widget.App.Group"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/space_16"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginBottom="@dimen/floating_action_clearance"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_default="wrap"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/roles_filter_scrollview"
            app:layout_goneMarginTop="@dimen/space_8"
            app:layout_constraintVertical_bias="0">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/players_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Stato vuoto: o non c'e' nessun giocatore (con la strada per aggiungerne) o la ricerca non trova niente. -->
        <it.vantaggi.scoreboardessential.ui.EmptyStateView
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:emptyAction="@string/players_empty_action"
            app:emptyIcon="@drawable/ic_person_add"
            app:emptyReason="@string/no_players_hint"
            app:emptyTitle="@string/no_players_yet"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Galleggia sopra la lista: e' l'unico elemento con un'ombra (shadow-floating), e il primario della regione. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_player_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_16"
        android:contentDescription="@string/label_add_player"
        app:backgroundTint="@color/accent_default"
        app:tint="@color/on_accent"
        app:shapeAppearance="@style/ShapeAppearance.App.Control"
        app:srcCompat="@drawable/ic_person_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
