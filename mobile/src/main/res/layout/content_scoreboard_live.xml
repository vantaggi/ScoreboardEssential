<?xml version="1.0" encoding="utf-8"?>
<!--
    La colonna di gioco, a slot fissi (DESIGN.md, Gioco: colonna a slot fissi). Dall'alto: barra,
    riga dei nomi, numeri (l'unico spazio che si allarga), dettaglio, striscia, zone +.

    Regola: durante la partita nessuna vista di questa schermata cambia misura. Le altezze sono
    fisse e le visibilita' GONE/VISIBLE le decide solo MainActivity.applyCapabilities, al cambio
    sport. Quello che cambia a partita in corso e' il contenuto (testo, colore, abilitato), mai lo
    spazio: ANNULLA si spegne invece di sparire, il pallino del servizio e' INVISIBLE e non GONE.
    Cosi' il + sta sempre dove il dito se lo aspetta, anche senza guardare.

    Gli inset di sistema arrivano come padding di questa radice (MainActivity): 16dp ai lati e 8dp
    sopra la barra di navigazione. Il colore della squadra vive solo nelle zone + e nella
    barretta sotto il nome, mai dietro il numero.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scoreboard_live"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="8dp">

    <!--
        Barra. Nel calcio: il tempo come pulsante (il glifo dice se corre), lo slot del portiere
        (di sola lettura), poi orologio e PARTITA. Nel padel e nel tennis il tempo e il portiere
        sono GONE e il testo del periodo prende il loro posto. RESET del tempo e impostazioni non
        sono qui: stanno nel foglio.
    -->
    <LinearLayout
        android:id="@+id/game_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/game_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/timer_start_button"
            style="@style/Widget.App.Button.Street"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:maxLines="1"
            android:text="00:00"
            android:textAppearance="@style/TextAppearance.App.Game.Clock"
            android:textColor="@color/sidewalk_gray"
            android:onClick="startStopTimer"
            app:backgroundTint="@color/concrete_gray"
            app:icon="@drawable/ic_play"
            app:iconTint="@color/stencil_white"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            tools:ignore="HardcodedText" />

        <!-- Il portiere: sempre presente nel calcio, mai toccabile in questa fase. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/keeper_slot"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:minWidth="104dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:shapeAppearance="@style/ShapeAppearance.App.StreetBadge"
            app:strokeColor="@color/outline_gray"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/keeper_timer_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_keeper_timer"
                    android:textAppearance="@style/TextAppearance.App.Game.Caption" />

                <TextView
                    android:id="@+id/keeper_timer_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="05:00"
                    android:textAppearance="@style/TextAppearance.App.Game.Value"
                    android:textColor="@color/sidewalk_gray"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Periodo e servizio. Sempre in barra e vuoto quando non c'e' niente da dire: fa anche da molla. -->
        <TextView
            android:id="@+id/match_period_textview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Game.Command"
            android:textColor="@color/stencil_white"
            tools:text="SET 2 - SERVE ROSSI" />

        <ImageView
            android:id="@+id/wear_status_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cd_wear_status"
            android:padding="8dp"
            android:src="@drawable/ic_watch_disconnected"
            tools:src="@drawable/ic_watch_connected" />

        <!-- Apre il foglio PARTITA: rose, registro, formazioni e azioni stanno li'. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/match_sheet_button"
            style="@style/Widget.App.Button.TextButton.Street"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/cd_open_match_sheet"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minWidth="64dp"
            android:paddingHorizontal="4dp"
            android:text="@string/label_open_match_sheet"
            android:textColor="@color/stencil_white"
            android:textSize="12sp" />
    </LinearLayout>

    <!--
        Riga dei nomi. Il -1 sta al bordo esterno (a sinistra per la squadra 1, a destra per la 2),
        lontano dal + che si colpisce senza guardare: negli sport a set e' GONE. Il nome apre la
        rinomina. Sotto il nome la barretta nel colore della squadra e, prima del nome, lo slot da
        12dp del pallino del servizio.
    -->
    <LinearLayout
        android:id="@+id/names_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/game_names_height"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/team1_subtract_button_card"
                style="@style/Widget.App.Button.OutlinedButton.Street"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="48dp"
                android:paddingHorizontal="8dp"
                android:text="@string/label_correct_minus_one"
                android:textAppearance="@style/TextAppearance.App.Game.Command"
                app:strokeWidth="2dp" />

            <LinearLayout
                android:id="@+id/team1_name_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/cd_edit_team_1_name"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/team1_serve_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_serve_dot"
                        android:importantForAccessibility="no"
                        android:visibility="invisible" />

                    <TextView
                        android:id="@+id/team1_name_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.App.Game.Name"
                        tools:text="TEAM 1" />
                </LinearLayout>

                <View
                    android:id="@+id/team1_color_bar"
                    android:layout_width="60dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/team2_name_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/cd_edit_team_2_name"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/team2_serve_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_serve_dot"
                        android:importantForAccessibility="no"
                        android:visibility="invisible" />

                    <TextView
                        android:id="@+id/team2_name_textview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.App.Game.Name"
                        tools:text="TEAM 2" />
                </LinearLayout>

                <View
                    android:id="@+id/team2_color_bar"
                    android:layout_width="60dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/team2_subtract_button_card"
                style="@style/Widget.App.Button.OutlinedButton.Street"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="48dp"
                android:paddingHorizontal="8dp"
                android:text="@string/label_correct_minus_one"
                android:textAppearance="@style/TextAppearance.App.Game.Command"
                app:strokeWidth="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!--
        I numeri: l'unico spazio che si allarga (peso 1). Bianco su nero, dimensione FISSA per
        tutta la partita, calcolata una volta per sport in MainActivity: niente autoSize, che
        cambierebbe grandezza fra 1 e 15. Non sono toccabili.
    -->
    <LinearLayout
        android:id="@+id/score_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/team1_score_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:accessibilityLiveRegion="polite"
                android:maxLines="1"
                android:text="0"
                android:textAppearance="@style/TextAppearance.App.Game.Score"
                tools:ignore="HardcodedText" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/team2_score_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:accessibilityLiveRegion="polite"
                android:maxLines="1"
                android:text="0"
                android:textAppearance="@style/TextAppearance.App.Game.Score"
                tools:ignore="HardcodedText" />
        </FrameLayout>
    </LinearLayout>

    <!--
        Il dettaglio, solo negli sport a set: game o set e game, sempre dal punto di vista della
        squadra di sinistra come la schermata. GONE nel calcio, deciso in applyCapabilities.
    -->
    <LinearLayout
        android:id="@+id/score_detail_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/game_detail_height"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/score_detail_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Game.Value"
            android:textColor="@color/stencil_white"
            tools:text="5-3" />

        <TextView
            android:id="@+id/score_detail_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Game.Caption"
            tools:text="GAME" />
    </LinearLayout>

    <!--
        La striscia dell'ultima azione. Cambia il testo, mai l'altezza: ANNULLA si spegne quando non
        c'e' niente da annullare, non sparisce. Il testo a sinistra lo scrive il passo successivo.
    -->
    <LinearLayout
        android:id="@+id/last_action_strip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/game_strip_height"
        android:background="@color/concrete_gray"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="0dp">

        <TextView
            android:id="@+id/last_action_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Game.Command"
            android:textColor="@color/stencil_white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/undo_goal_button"
            style="@style/Widget.App.Button.TextButton.Street"
            android:layout_width="96dp"
            android:layout_height="@dimen/game_strip_height"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:enabled="false"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="@string/undo"
            android:textAppearance="@style/TextAppearance.App.Game.Command"
            android:textColor="@color/stencil_white"
            app:icon="@drawable/ic_undo"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconTint="@color/stencil_white" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!--
        Le zone +: il bersaglio primario, nella fascia che il pollice raggiunge senza cambiare
        presa. Il colore, il glifo e lo stroke li imposta MainActivity dal colore della squadra
        (TeamInk); 16dp di stacco neutro al centro.
    -->
    <LinearLayout
        android:id="@+id/zones_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/game_zone_height"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/team1_add_button_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/cd_increase_team_1"
            android:focusable="true"
            app:cardBackgroundColor="@color/team_spray_yellow"
            app:cardElevation="0dp"
            app:shapeAppearance="@style/ShapeAppearance.App.StreetButton"
            app:strokeColor="@color/stencil_white"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/team1_plus_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_plus" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/team2_add_button_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/cd_increase_team_2"
            android:focusable="true"
            app:cardBackgroundColor="@color/neon_cyan"
            app:cardElevation="0dp"
            app:shapeAppearance="@style/ShapeAppearance.App.StreetButton"
            app:strokeColor="@color/stencil_white"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/team2_plus_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_plus" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
