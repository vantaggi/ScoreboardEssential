<?xml version="1.0" encoding="utf-8"?>
<!--
    Impostazioni (G-4, revisione dei menu passo 3b). Quattro gruppi tonali per argomento, nell'ordine in
    cui si usano: Squadre, Regole, Padel Elite, App (lingua e alto contrasto, che non sono della partita).
    Dentro, righe separate da una linea sottile rientrata al bordo del testo. Niente card, niente ombre.
    Il colore della squadra e' un cerchio del colore scelto accanto al nome, non piu' un'icona in un
    quadrato colorato: si tocca e apre la tavolozza; per TalkBack resta "Colore squadra 1".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background_canvas" android:fitsSystemWindows="true" tools:context=".ui.MatchSettingsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.App.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_16">

        <!-- Squadre: nome e colore, una riga per squadra. -->
        <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Group" android:layout_width="match_parent" android:layout_height="wrap_content">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/space_16" android:paddingTop="@dimen/space_16" android:text="@string/settings_teams_title" android:textAppearance="@style/TextAppearance.App.RowTitle" android:textColor="@color/text_secondary" android:accessibilityHeading="true" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="@dimen/space_16" android:paddingVertical="@dimen/space_12">

                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.App.TextInputLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/label_team_1">

                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/team1NameEdittext" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton android:id="@+id/team1ColorButton" style="@style/Widget.App.Button.Secondary" android:layout_width="@dimen/control_touch" android:layout_height="@dimen/control_touch" android:layout_marginStart="@dimen/space_8" android:contentDescription="@string/btn_team_1_color" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" app:shapeAppearance="@style/ShapeAppearance.App.Swatch" />
                </LinearLayout>

                <View style="@style/Widget.App.RowDivider" android:layout_width="match_parent" android:layout_height="@dimen/border_width" android:layout_marginStart="@dimen/space_16" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="@dimen/space_16" android:paddingVertical="@dimen/space_12">

                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.App.TextInputLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/label_team_2">

                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/team2NameEdittext" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton android:id="@+id/team2ColorButton" style="@style/Widget.App.Button.Secondary" android:layout_width="@dimen/control_touch" android:layout_height="@dimen/control_touch" android:layout_marginStart="@dimen/space_8" android:contentDescription="@string/btn_team_2_color" android:insetTop="0dp" android:insetBottom="0dp" android:paddingHorizontal="0dp" app:shapeAppearance="@style/ShapeAppearance.App.Swatch" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Regole: sport (con le regole che il motore applica), regola del 40-40 e timer del portiere dove ci sono. -->
        <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/space_16" android:paddingTop="@dimen/space_16" android:text="@string/settings_match_title" android:textAppearance="@style/TextAppearance.App.RowTitle" android:textColor="@color/text_secondary" android:accessibilityHeading="true" />

                <LinearLayout android:id="@+id/sportRow" style="@style/Widget.App.Pressable" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:foreground="@drawable/bg_focus_ring" android:gravity="center_vertical" android:minHeight="@dimen/control_touch" android:orientation="horizontal" android:paddingHorizontal="@dimen/space_16" android:paddingVertical="@dimen/space_12">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_sport_title" android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <TextView android:id="@+id/sportValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_12" android:textAppearance="@style/TextAppearance.App.Caption" />

                    <ImageView android:layout_width="@dimen/icon_standard" android:layout_height="@dimen/icon_standard" android:layout_marginStart="@dimen/space_8" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right" app:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- La regola del 40-40, solo negli sport con racchetta: punto secco, killer point, vantaggi. -->
                <LinearLayout android:id="@+id/deuceRuleLayout" style="@style/Widget.App.Pressable" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:foreground="@drawable/bg_focus_ring" android:gravity="center_vertical" android:minHeight="@dimen/control_touch" android:orientation="horizontal" android:paddingHorizontal="@dimen/space_16" android:paddingVertical="@dimen/space_12" android:visibility="gone">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_deuce_title" android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <TextView android:id="@+id/deuceValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_12" android:textAppearance="@style/TextAppearance.App.Caption" />

                    <ImageView android:layout_width="@dimen/icon_standard" android:layout_height="@dimen/icon_standard" android:layout_marginStart="@dimen/space_8" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right" app:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- Le regole che il motore applica allo sport scelto, composte da SportRegistry. -->
                <TextView android:id="@+id/sportRulesText" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/space_16" android:paddingBottom="@dimen/space_12" android:textAppearance="@style/TextAppearance.App.Caption" />

                <LinearLayout android:id="@+id/keeperTimerCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <View style="@style/Widget.App.RowDivider" android:layout_width="match_parent" android:layout_height="@dimen/border_width" android:layout_marginStart="@dimen/space_16" />

                    <!-- Il cambio portiere a tempo: spento non c'e' il conto ne' la barra, e si cambia a mano (per gol subiti, per esempio). -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="@dimen/control_touch" android:orientation="horizontal" android:paddingHorizontal="@dimen/space_16" android:paddingVertical="@dimen/space_12">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_keeper_title" android:textAppearance="@style/TextAppearance.App.RowTitle" />

                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="@string/settings_keeper_summary" android:textAppearance="@style/TextAppearance.App.Caption" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/keeperSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_16" android:contentDescription="@string/settings_keeper_title" />
                    </LinearLayout>

                    <!-- La durata: l'etichetta sta sopra il campo e va a capo, invece di stare nel bordo del campo, dove a caratteri grandi si tagliava («Durata del portiere (minu…»). Bozza B1 scelta da Cioti. -->
                    <LinearLayout android:id="@+id/keeperTimerField" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_16" android:layout_marginBottom="@dimen/space_12" android:orientation="vertical">

                        <TextView android:id="@+id/keeperTimerLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_4" android:labelFor="@+id/keeperTimerEdittext" android:text="@string/keeper_timer_minutes" android:textAppearance="@style/TextAppearance.App.Caption" />

                        <com.google.android.material.textfield.TextInputLayout android:id="@+id/keeperTimerLayout" style="@style/Widget.App.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content">

                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/keeperTimerEdittext" android:layout_width="match_parent" android:layout_height="wrap_content" android:digits="0123456789.," android:imeOptions="actionDone" android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!--
            Padel Elite: il gruppo c'e' solo se la build conosce il Supabase (local.properties). Una riga sola
            che porta alla sua schermata (passo 4): senza accesso "Accedi a Padel Elite" e "Non collegato", con accesso il
            gruppo per l'invio, l'account e il gruppo scelto. Esci sta nella schermata di Padel Elite.
        -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/padelEliteCard" style="@style/Widget.App.Group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24" android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/space_16" android:paddingTop="@dimen/space_16" android:text="@string/padel_elite_title" android:textAppearance="@style/TextAppearance.App.RowTitle" android:textColor="@color/text_secondary" android:accessibilityHeading="true" />

                <LinearLayout android:id="@+id/padelEliteRow" style="@style/Widget.App.Pressable" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:foreground="@drawable/bg_focus_ring" android:gravity="center_vertical" android:minHeight="@dimen/control_touch" android:orientation="horizontal" android:paddingHorizontal="@dimen/space_16" android:paddingVertical="@dimen/space_12">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                        <TextView android:id="@+id/padelEliteRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/padel_elite_login_title" android:textAppearance="@style/TextAppearance.App.RowTitle" />

                        <TextView android:id="@+id/padelEliteStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="@string/padel_elite_settings_signed_out" android:textAppearance="@style/TextAppearance.App.Caption" />
                    </LinearLayout>

                    <ImageView android:layout_width="@dimen/icon_standard" android:layout_height="@dimen/icon_standard" android:layout_marginStart="@dimen/space_12" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right" app:tint="@color/text_secondary" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- App: cio' che vale per tutta l'app e non per la partita. La lingua, poi l'alto contrasto (G-10): titolo, perche', interruttore. -->
        <com.google.android.material.card.MaterialCardView style="@style/Widget.App.Group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_24">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="@dimen/space_16" android:paddingTop="@dimen/space_16" android:text="@string/settings_app_title" android:textAppearance="@style/TextAppearance.App.RowTitle" android:textColor="@color/text_secondary" android:accessibilityHeading="true" />

                <LinearLayout android:id="@+id/appearanceRow" style="@style/Widget.App.Pressable" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:foreground="@drawable/bg_focus_ring" android:gravity="center_vertical" android:minHeight="@dimen/control_touch" android:orientation="horizontal" android:paddingHorizontal="@dimen/space_16" android:paddingVertical="@dimen/space_12">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/appearance_title" android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <TextView android:id="@+id/appearanceValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_12" android:textAppearance="@style/TextAppearance.App.Caption" />

                    <ImageView android:layout_width="@dimen/icon_standard" android:layout_height="@dimen/icon_standard" android:layout_marginStart="@dimen/space_8" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right" app:tint="@color/text_secondary" />
                </LinearLayout>

                <View style="@style/Widget.App.RowDivider" android:layout_width="match_parent" android:layout_height="@dimen/border_width" android:layout_marginStart="@dimen/space_16" />

                <LinearLayout android:id="@+id/languageRow" style="@style/Widget.App.Pressable" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:foreground="@drawable/bg_focus_ring" android:gravity="center_vertical" android:minHeight="@dimen/control_touch" android:orientation="horizontal" android:paddingHorizontal="@dimen/space_16" android:paddingVertical="@dimen/space_12">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/language" android:textAppearance="@style/TextAppearance.App.RowTitle" />

                    <TextView android:id="@+id/languageValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_12" android:textAppearance="@style/TextAppearance.App.Caption" />

                    <ImageView android:layout_width="@dimen/icon_standard" android:layout_height="@dimen/icon_standard" android:layout_marginStart="@dimen/space_8" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right" app:tint="@color/text_secondary" />
                </LinearLayout>

                <View style="@style/Widget.App.RowDivider" android:layout_width="match_parent" android:layout_height="@dimen/border_width" android:layout_marginStart="@dimen/space_16" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="@dimen/space_16" android:paddingVertical="@dimen/space_12">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_high_contrast_title" android:textAppearance="@style/TextAppearance.App.RowTitle" />

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4" android:text="@string/settings_high_contrast_summary" android:textAppearance="@style/TextAppearance.App.Caption" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/highContrastSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_16" android:contentDescription="@string/settings_high_contrast_title" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
    </ScrollView>
</LinearLayout>
